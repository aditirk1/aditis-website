# Copy to .env for local Astro (PUBLIC_* only).
# Server secrets go in Cloudflare Pages → Settings → Environment variables.

# --- Contact form (recommended first — powers "Work with me" on /services) ---
# Free key at https://web3forms.com
# PUBLIC_WEB3FORMS_ACCESS_KEY=your-key-here

# --- Stripe (optional — leave off until configured) ---
# When ready: create a Price in Stripe, set secrets on Cloudflare, then uncomment:
# PUBLIC_STRIPE_CHECKOUT=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# Test checkout locally: npm run build && npx wrangler pages dev ./dist

# --- Visitor globe (Cloudflare Pages + KV; not used by astro dev alone) ---
# Create KV in Cloudflare, bind as VISITOR_KV in Pages + wrangler.toml.
# Set ADMIN_STATS_SECRET in Cloudflare (encrypted), not here — use /admin/visitors.
# PUBLIC_VISITOR_API_BASE=

# --- Analytics (optional) ---
# PUBLIC_UMAMI_SCRIPT_URL=
# PUBLIC_UMAMI_WEBSITE_ID=
