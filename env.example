# Copy to .env for local Astro (PUBLIC_* only). Server secrets are not available in `astro dev`
# for Pages Functions — use `npx wrangler pages dev ./dist` to test /api/checkout locally.

# Show “Pay securely (Stripe)” on /services
PUBLIC_STRIPE_CHECKOUT=true

# Stripe (set in Cloudflare Pages → Settings → Environment variables for Production + Preview)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
