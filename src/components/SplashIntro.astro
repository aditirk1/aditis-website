---
/**
 * First homepage visit per session: logo alone, then title rises in below,
 * then letters scatter and the overlay reveals the site.
 *
 * Shimmer markup/CSS match the pre-redesign splash (img + screen overlay clipped
 * to the circular wrap). Splash wordmark omits the hero's trailing full stop.
 */
import home from '../data/home.json';

/* Words, not one run of characters: phones stack them, and the gap between them is margin, not a lone &nbsp;. */
const words = home.hero_title
	.replace(/\.$/, '')
	.split(/\s+/)
	.filter(Boolean)
	.map((w) => w.split(''));
---

<!-- Runs before first paint when splash already completed this session -->
<script is:inline>
	try {
		if (sessionStorage.getItem('aditi-splash-seen') === '1') {
			document.documentElement.setAttribute('data-splash-skip', '1');
		}
	} catch (e) {}
</script>

<style is:global>
	html[data-splash-skip='1'] #splash-intro,
	html[data-theme='portfolio'] #splash-intro {
		display: none !important;
		pointer-events: none !important;
		visibility: hidden !important;
	}
</style>

<script is:inline>
	/* Title is static (no letter sweep) — mark ready immediately so CSS never hides it. */
	(function () {
		try {
			document.documentElement.setAttribute('data-hero-ready', '1');
		} catch (e) {}
	})();
</script>

<div
	id="splash-intro"
	class="fixed inset-0 z-50 flex items-center justify-center overflow-hidden bg-[var(--page-bg)]"
	aria-hidden="true"
>
	<div class="splash-starfield pointer-events-none absolute inset-0" aria-hidden="true"></div>

	<div class="splash-stage relative z-10 flex flex-col items-center justify-center" data-splash-stage>
		<div class="splash-logo-wrap relative" data-splash-logo-wrap>
			<div class="splash-logo-shimmer" aria-hidden="true"></div>
			<img
				src="/brand/logo-universe-512.png"
				alt=""
				class="splash-logo block h-[140px] w-[140px] select-none opacity-0 md:h-[180px] md:w-[180px]"
				width="180"
				height="180"
				decoding="async"
				loading="eager"
				data-splash-logo
			/>
		</div>

		<p
			class="splash-title pointer-events-none m-0 select-none text-center font-extralight text-[var(--page-fg)]"
			style="font-family: 'Inter', system-ui, sans-serif; font-weight: 200; visibility: hidden"
			data-splash-title
		>
			{words.map((word) => (
				<span class="splash-word">
					{word.map((ch) => (
						<span class="splash-char inline-block will-change-transform">{ch}</span>
					))}
				</span>
			))}
		</p>
	</div>
</div>

<style>
	.splash-starfield {
		background-image:
			radial-gradient(1px 1px at 20% 30%, rgba(255, 255, 255, 0.45), transparent),
			radial-gradient(1px 1px at 60% 70%, rgba(255, 255, 255, 0.35), transparent),
			radial-gradient(1px 1px at 80% 20%, rgba(255, 220, 180, 0.5), transparent),
			radial-gradient(1px 1px at 40% 85%, rgba(255, 255, 255, 0.3), transparent),
			radial-gradient(1px 1px at 10% 60%, rgba(255, 200, 140, 0.4), transparent),
			radial-gradient(1px 1px at 90% 45%, rgba(255, 255, 255, 0.3), transparent);
		background-size: 100% 100%;
		opacity: 0.55;
	}

	.splash-logo-wrap {
		overflow: hidden;
		border-radius: 50%;
	}

	/*
	 * Phones: one word per line, sized to the screen with room at the sides.
	 * Desktop: one line, words spaced by margin. Nudged right so the wordmark
	 * sits under the logo's visual centre, not its box's.
	 */
	.splash-title {
		box-sizing: border-box;
		max-width: 100vw;
		margin-top: 1.75rem;
		padding-inline: 1.5rem;
		font-size: clamp(2.5rem, 13.5vw, 4rem);
		line-height: 1.12;
		letter-spacing: 0.16em;
		translate: 0.08em 0;
	}

	.splash-word {
		display: block;
		white-space: nowrap;
	}

	@media (min-width: 768px) {
		.splash-title {
			margin-top: 1.5rem;
			padding-inline: 0;
			font-size: 3.75rem;
			line-height: 1;
			letter-spacing: 0.28em;
			white-space: nowrap;
			translate: 0.15em 0;
		}

		.splash-word {
			display: inline-block;
		}

		/* Matches the old tracked &nbsp; gap: trailing tracking + space + tracking. */
		.splash-word + .splash-word {
			margin-left: 0.8em;
		}
	}

	@media (min-width: 1024px) {
		.splash-title {
			font-size: 4.5rem;
		}
	}

	.splash-logo-shimmer {
		position: absolute;
		inset: -8%;
		background: linear-gradient(
			105deg,
			transparent 0%,
			transparent 38%,
			rgba(255, 255, 255, 0.15) 44%,
			rgba(255, 235, 180, 0.75) 50%,
			rgba(255, 255, 255, 0.2) 56%,
			transparent 62%,
			transparent 100%
		);
		background-size: 220% 100%;
		background-position: 120% center;
		animation: splash-logo-shimmer 2.4s ease-in-out infinite;
		mix-blend-mode: screen;
		pointer-events: none;
	}

	html[data-theme='beach'] .splash-logo-shimmer {
		background: linear-gradient(
			105deg,
			transparent 0%,
			transparent 38%,
			rgba(255, 255, 255, 0.2) 44%,
			rgba(180, 220, 255, 0.85) 50%,
			rgba(255, 255, 255, 0.25) 56%,
			transparent 62%,
			transparent 100%
		);
		background-size: 220% 100%;
		background-position: 120% center;
	}

	@keyframes splash-logo-shimmer {
		0% {
			background-position: 120% center;
		}
		100% {
			background-position: -30% center;
		}
	}
</style>

<script>
	import { initSplashIntro } from '../scripts/splash-intro';
	initSplashIntro();
</script>
