---
/**
 * First homepage visit per session: "aditi's universe" text fades in, holds briefly,
 * then each letter scatters outward (GSAP stagger with random trajectories).
 * Overlay fades to transparent and is removed — revealing the real site.
 *
 * No flash on refresh: inline script marks html before paint when already seen.
 */
const splashText = "aditi's universe";
const chars = splashText.split('');
---

<!-- Runs before first paint when splash already completed this session -->
<script is:inline>
	try {
		if (sessionStorage.getItem('aditi-splash-seen') === '1') {
			document.documentElement.setAttribute('data-splash-skip', '1');
		}
	} catch (e) {}
</script>

<style is:global>
	html[data-splash-skip='1'] #splash-intro {
		display: none !important;
		pointer-events: none !important;
		visibility: hidden !important;
	}
</style>

<div
	id="splash-intro"
	class="fixed inset-0 z-50 flex items-center justify-center overflow-hidden bg-[var(--page-bg)]"
	aria-hidden="true"
>
	<div class="splash-starfield pointer-events-none absolute inset-0" aria-hidden="true"></div>
	<p
		class="splash-title relative z-10 select-none text-center text-4xl font-light tracking-[0.35em] text-[var(--page-fg)] opacity-0 md:text-6xl lg:text-7xl"
		style="font-family: var(--font-display)"
		data-splash-title
	>
		{chars.map((ch) => (
			<span class="splash-char inline-block will-change-transform">
				{ch === ' ' ? '\u00a0' : ch}
			</span>
		))}
	</p>
</div>

<style>
	.splash-starfield {
		background-image:
			radial-gradient(1px 1px at 20% 30%, rgba(255, 255, 255, 0.45), transparent),
			radial-gradient(1px 1px at 60% 70%, rgba(255, 255, 255, 0.35), transparent),
			radial-gradient(1px 1px at 80% 20%, rgba(255, 220, 180, 0.5), transparent),
			radial-gradient(1px 1px at 40% 85%, rgba(255, 255, 255, 0.3), transparent),
			radial-gradient(1px 1px at 10% 60%, rgba(255, 200, 140, 0.4), transparent),
			radial-gradient(1px 1px at 90% 45%, rgba(255, 255, 255, 0.3), transparent);
		background-size: 100% 100%;
		opacity: 0.55;
	}
</style>

<script>
	import { initSplashIntro } from '../scripts/splash-intro';
	initSplashIntro();
</script>
