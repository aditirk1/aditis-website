---
/**
 * Contact modal — Web3Forms (https://web3forms.com) posts to their API; no backend on your side.
 *
 * Set PUBLIC_WEB3FORMS_ACCESS_KEY in .env (and Cloudflare Pages env) to your form access key.
 * If missing, the form still renders but submissions will fail until you add the key.
 */
interface Props {
	accessKey?: string;
}

const { accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '' } = Astro.props;
---

<dialog class="app-modal-backdrop pointer-events-auto" data-contact-modal aria-labelledby="contact-modal-title">
	<div
		class="contact-modal__surface pointer-events-auto w-[min(100%,420px)] max-h-[min(90dvh,calc(100vh-2rem))] overflow-y-auto rounded-2xl border border-[color-mix(in_srgb,var(--color-amber)_40%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_95%,transparent)] p-6 text-[var(--page-fg)] shadow-2xl"
		data-contact-surface
	>
	<div class="flex items-start justify-between gap-4">
		<h2 id="contact-modal-title" class="text-xl font-bold" style="font-family: var(--font-display)">
			Work with me
		</h2>
		<button
			type="button"
			class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_25%,transparent)] px-2 py-0.5 text-sm hover:border-[var(--color-amber)]"
			data-contact-close
		>
			✕
		</button>
	</div>
	<p class="mt-2 text-sm text-[var(--page-muted)]">Tell me what you’re building. I’ll reply by email.</p>

	<form
		class="mt-6 flex flex-col gap-3"
		action="https://api.web3forms.com/submit"
		method="POST"
		data-contact-form
	>
		<input type="hidden" name="access_key" value={accessKey} />
		<input type="hidden" name="subject" value="aditirk.me — contact" />
		<input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

		<label class="flex flex-col gap-1 text-sm">
			<span>Name</span>
			<input
				required
				name="name"
				class="rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] bg-transparent px-3 py-2"
			/>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span>Email</span>
			<input
				required
				type="email"
				name="email"
				class="rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] bg-transparent px-3 py-2"
			/>
		</label>
		<label class="flex flex-col gap-1 text-sm">
			<span>Message</span>
			<textarea
				name="message"
				required
				rows={5}
				class="rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] bg-transparent px-3 py-2"
			></textarea>
		</label>
		<button
			type="submit"
			class="mt-2 rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_15%,transparent)] py-2.5 text-sm font-bold text-[var(--color-amber)]"
		>
			Send
		</button>
		<p class="text-xs text-[var(--page-muted)]" data-contact-status hidden></p>
	</form>
	</div>
</dialog>

<script>
	import { gsap } from 'gsap';

	const modal = document.querySelector('[data-contact-modal]') as HTMLDialogElement | null;
	const surface = document.querySelector('[data-contact-surface]') as HTMLElement | null;
	const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
	const statusEl = document.querySelector('[data-contact-status]') as HTMLElement | null;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('[data-contact-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (!modal) return;
			modal.showModal();
			if (surface && !reduceMotion) {
				gsap.from(surface, { scale: 0.94, opacity: 0, duration: 0.35, ease: 'power3.out' });
			}
		});
	});

	document.querySelectorAll('[data-contact-close]').forEach((btn) => {
		btn.addEventListener('click', () => modal?.close());
	});

	modal?.addEventListener('click', (e) => {
		if (e.target === modal) modal.close();
	});

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form || !statusEl) return;
		const fd = new FormData(form);
		const key = fd.get('access_key');
		if (!key) {
			statusEl.hidden = false;
			statusEl.textContent = 'Add PUBLIC_WEB3FORMS_ACCESS_KEY to your environment.';
			return;
		}
		statusEl.hidden = false;
		statusEl.textContent = 'Sending…';
		try {
			const res = await fetch(form.action, { method: 'POST', body: fd });
			const data = (await res.json()) as { success?: boolean; message?: string };
			if (data.success) {
				statusEl.textContent = 'Sent. Thank you.';
				form.reset();
			} else {
				statusEl.textContent = data.message || 'Something went wrong.';
			}
		} catch {
			statusEl.textContent = 'Network error.';
		}
	});
</script>
