---
/**
 * Beach theme: looping shoreline footage (see beach-shore.ts). The poster is a
 * CSS background in global.css, so it paints before scripts run and is never
 * fetched while Universe is active.
 */
interface Props {
	home?: boolean;
}

const { home = false } = Astro.props;
---

<div
	class="beach-background pointer-events-none fixed inset-0 z-0 overflow-hidden"
	data-beach-background
	data-home={home ? '' : undefined}
	aria-hidden="true"
>
	<video class="beach-shore-video" data-beach-video muted playsinline disablepictureinpicture disableremoteplayback preload="none"></video>
	<video class="beach-shore-video" data-beach-video muted playsinline disablepictureinpicture disableremoteplayback preload="none"></video>
	<div class="beach-shore-scrim"></div>
</div>

<script>
	import { initBeachShore } from '../scripts/beach-shore.ts';
	import { subscribeScroll } from '../scripts/scroll-orchestrator.ts';

	let dispose: (() => void) | undefined;
	let unsubscribeScroll = () => {};

	function boot() {
		dispose?.();
		unsubscribeScroll();
		dispose = initBeachShore();

		/* Home: footage stays vivid behind the hero, then washes out behind the text below it. */
		const homeRoot = document.querySelector<HTMLElement>('[data-beach-background][data-home]');
		if (homeRoot) {
			unsubscribeScroll = subscribeScroll(({ heroBottom, viewportHeight }) => {
				const scrolled = Math.min(1, Math.max(0, 1 - heroBottom / viewportHeight));
				homeRoot.style.setProperty('--hero-scrolled', scrolled.toFixed(3));
			});
		}
	}

	boot();

	if (import.meta.hot) {
		import.meta.hot.dispose(() => {
			dispose?.();
			unsubscribeScroll();
		});
	}
</script>
