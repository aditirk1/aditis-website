---
/**
 * Beach theme: minimal solid/soft gradient only — no photos, waves, or illustration.
 */
---

<div
	class="beach-background pointer-events-none fixed inset-0 z-0 overflow-hidden"
	data-beach-canvas
	aria-hidden="true"
	hidden
>
	<div class="absolute inset-0 beach-plain-bg" aria-hidden="true"></div>

	<button
		type="button"
		class="pointer-events-auto absolute bottom-[8%] right-[8%] z-[2] rounded-full border-2 border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-beach-bg)_88%,transparent)] px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#142a42] shadow-md backdrop-blur-sm transition hover:opacity-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#ffaa00]"
		data-beach-dream-journal
		aria-label="Enter Dream Journal"
		title="Dream Journal"
	>
		Dreams
	</button>
</div>

<style>
	.beach-plain-bg {
		background: linear-gradient(165deg, #f0f7fc 0%, #fdf8f0 45%, #f5ebe0 100%);
	}
</style>

<script>
	const root = document.querySelector('[data-beach-canvas]') as HTMLElement | null;
	const dreamBtn = document.querySelector('[data-beach-dream-journal]') as HTMLButtonElement | null;

	function applyThemeVisibility() {
		const t = document.documentElement.getAttribute('data-theme');
		if (!root) return;
		if (t === 'beach') {
			root.hidden = false;
			root.style.visibility = 'visible';
		} else {
			root.hidden = true;
			root.style.visibility = 'hidden';
		}
	}

	applyThemeVisibility();
	const mo = new MutationObserver(applyThemeVisibility);
	mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

	dreamBtn?.addEventListener('click', () => {
		window.location.href = '/dream-journal';
	});
</script>
