---
/**
 * Flow theme (data-theme="beach"): looping water video behind the site.
 * See flow-video-background.ts for when it loads and plays.
 */
---

<div
	class="beach-background pointer-events-none fixed inset-0 z-0 overflow-hidden"
	data-beach-canvas
	aria-hidden="true"
	hidden
>
	<video
		class="flow-video"
		data-flow-video
		muted
		loop
		playsinline
		disablepictureinpicture
		preload="none"
		poster="/media/flow-water-poster.jpg"
		tabindex="-1"
	>
		<source src="/media/flow-water.webm" type="video/webm" />
		<source src="/media/flow-water.mp4" type="video/mp4" />
	</video>
</div>

<style>
	.flow-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Poster and first frame share this, so there's no flash while it buffers. */
		background: #2f6496 url('/media/flow-water-poster.jpg') center / cover no-repeat;
	}
</style>

<script>
	import { initFlowVideoBackground } from '../scripts/flow-video-background.ts';

	const dispose = initFlowVideoBackground();

	if (import.meta.hot) {
		import.meta.hot.dispose(() => dispose());
	}
</script>
