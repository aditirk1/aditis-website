---
/**
 * Beach theme: WebGL shader background (see beach-wave-field.ts).
 */
---

<div
	class="beach-background pointer-events-none fixed inset-0 z-0 overflow-hidden"
	data-beach-canvas
	aria-hidden="true"
	hidden
>
	<canvas id="beach-wave-canvas" class="block h-full w-full" aria-hidden="true"></canvas>
</div>

<script>
	import { initBeachWaveField } from '../scripts/beach-wave-field.ts';

	let dispose: (() => void) | undefined;

	function boot() {
		dispose?.();
		dispose = initBeachWaveField();
	}

	boot();

	if (import.meta.hot) {
		import.meta.hot.dispose(() => {
			dispose?.();
		});
	}
</script>
