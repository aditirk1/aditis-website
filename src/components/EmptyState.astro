---
/**
 * Placeholder for a section that has no published content yet.
 *
 * Both theme icons are rendered and CSS picks one, because the theme can be
 * toggled client-side after the page is served.
 */
interface Props {
	/** Short, human line. Keep it light — a visitor is reading this, not a log. */
	message: string;
	/** Optional second line, e.g. where to go instead. */
	hint?: string;
}

const { message, hint } = Astro.props;
---

<div class="empty-state" data-reveal-child>
	<span class="empty-state__icon" aria-hidden="true">
		<span data-theme-icon="universe">🌌</span>
		<span data-theme-icon="beach">🌊</span>
	</span>
	<p class="empty-state__message">{message}</p>
	{hint && <p class="empty-state__hint">{hint}</p>}
</div>

<style>
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		padding: 3.5rem 1.5rem 4.5rem;
		text-align: center;
	}

	.empty-state__icon {
		font-size: 2.75rem;
		line-height: 1;
		animation: empty-state-drift 5.5s ease-in-out infinite;
	}

	:global(html[data-theme='universe']) .empty-state__icon [data-theme-icon='beach'],
	:global(html[data-theme='beach']) .empty-state__icon [data-theme-icon='universe'] {
		display: none;
	}

	.empty-state__message {
		max-width: 34rem;
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--page-fg);
	}

	.empty-state__hint {
		max-width: 32rem;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--page-muted);
	}

	@keyframes empty-state-drift {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(0, -0.5rem, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.empty-state__icon {
			animation: none;
		}
	}
</style>
