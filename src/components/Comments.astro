---
import OAuthSignInButtons from './OAuthSignInButtons.astro';

interface Props {
	/** e.g. blog/my-post or thoughts/abc */
	scope: string;
}

const { scope } = Astro.props;
const returnPath = `/${scope}`;
---

<section class="comments-section" data-comments-root data-comments-scope={scope}>
	<h2 class="comments-section__title">Comments</h2>
	<p data-comments-status class="comments-section__status"></p>

	<div data-comments-auth class="comments-auth" hidden>
		<p class="comments-auth__title m-0" style="font-family: var(--font-display)">Sign in</p>
		<OAuthSignInButtons
			googleHref={`/api/dream-auth?provider=google&return_to=${encodeURIComponent(returnPath)}`}
			githubHref={`/api/dream-auth?provider=github&return_to=${encodeURIComponent(returnPath)}`}
		/>
	</div>

	<div data-comments-form-wrap class="comments-form-wrap" hidden>
		<p data-comments-who class="comments-who"></p>
		<form data-comments-form class="comments-form" autocomplete="off">
			<label class="comments-form__label">
				<span class="sr-only">Your comment</span>
				<textarea
					data-comments-input
					name="body"
					rows="3"
					maxlength="2000"
					required
					placeholder="Write a comment…"
					class="comments-form__input"
				></textarea>
			</label>
			<div class="comments-form__actions">
				<button type="submit" class="comments-form__submit">Post</button>
				<button type="button" data-comments-sign-out class="comments-form__signout">Sign out</button>
			</div>
		</form>
	</div>

	<div data-comments-list class="comments-list"></div>
</section>

<script>
	import { initComments } from '../scripts/comments.ts';

	const roots = document.querySelectorAll('[data-comments-root]');
	const stops: Array<() => void> = [];
	roots.forEach((root) => {
		if (root instanceof HTMLElement) stops.push(initComments(root));
	});
	if (import.meta.hot) {
		import.meta.hot.dispose(() => stops.forEach((s) => s()));
	}
</script>

<style>
	.comments-section {
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding-top: clamp(1.5rem, 3vw, 2rem);
		border-top: 1px solid color-mix(in srgb, var(--page-fg) 12%, transparent);
	}

	.comments-section__title {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: calc(1.35rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.comments-section__status {
		min-height: 1.25rem;
		margin: 0 0 1rem;
		font-size: calc(0.85rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		color: var(--page-muted);
	}

	.comments-auth {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		margin-bottom: 1.75rem;
		text-align: center;
	}

	.comments-auth__title {
		font-size: clamp(1.75rem, 5vw, 2.35rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: var(--page-fg);
	}

	.comments-who {
		margin: 0 0 0.65rem;
		font-size: calc(0.85rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		color: var(--page-muted);
	}

	.comments-form__input {
		width: 100%;
		resize: vertical;
		min-height: 5rem;
		border-radius: 0.75rem;
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		background: color-mix(in srgb, #000 18%, transparent);
		padding: 0.75rem 0.9rem;
		color: var(--page-fg);
		font: inherit;
		font-size: calc(1rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		line-height: 1.5;
		outline: none;
	}

	.comments-form__input:focus {
		border-color: var(--color-amber);
	}

	.comments-form__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
		margin-bottom: 1.5rem;
	}

	.comments-form__submit {
		border-radius: 999px;
		border: 1px solid var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		padding: 0.45rem 1.1rem;
		font-size: calc(0.85rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		font-weight: 600;
		color: var(--page-fg);
		cursor: pointer;
	}

	.comments-form__signout {
		border: 0;
		background: transparent;
		padding: 0;
		font-size: calc(0.85rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		color: var(--page-muted);
		text-decoration: underline;
		text-underline-offset: 0.12em;
		cursor: pointer;
	}

	.comments-empty {
		margin: 0;
		color: var(--page-muted);
		font-size: calc(0.95rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
	}

	.comments-item {
		padding: 1rem 0;
		border-top: 1px solid color-mix(in srgb, var(--page-fg) 10%, transparent);
	}

	.comments-item__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem 0.75rem;
		margin-bottom: 0.4rem;
		font-size: calc(0.8rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		color: var(--page-muted);
	}

	.comments-item__name {
		font-weight: 600;
		color: var(--page-fg);
	}

	.comments-item__via {
		opacity: 0.75;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.72em;
	}

	.comments-item__delete {
		margin-left: auto;
		border: 0;
		background: transparent;
		padding: 0;
		font-size: inherit;
		color: color-mix(in srgb, #ff8a8a 90%, white);
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}

	.comments-item__body {
		margin: 0;
		font-size: calc(1.05rem * var(--reader-scale, var(--reader-text-scale, 1.1)));
		line-height: 1.55;
		color: var(--page-fg);
		white-space: pre-wrap;
	}
</style>
