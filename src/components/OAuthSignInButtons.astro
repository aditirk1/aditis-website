---
/**
 * Shared Google / GitHub sign-in buttons with brand marks.
 */
interface Props {
	googleHref: string;
	githubHref: string;
	/** Extra class on the button stack */
	class?: string;
}

const { googleHref, githubHref, class: className = '' } = Astro.props;
---

<div class:list={['oauth-btns', className]}>
	<a href={googleHref} class="oauth-btn oauth-btn--google" data-comments-google>
		<span class="oauth-btn__icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="18" height="18">
				<path
					fill="#4285F4"
					d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
				></path>
				<path
					fill="#34A853"
					d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
				></path>
				<path
					fill="#FBBC05"
					d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
				></path>
				<path
					fill="#EA4335"
					d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
				></path>
			</svg>
		</span>
		Continue with Google
	</a>
	<a href={githubHref} class="oauth-btn oauth-btn--github" data-comments-github>
		<span class="oauth-btn__icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
				<path
					d="M12 1C5.9 1 1 5.9 1 12.1c0 4.9 3.2 9.1 7.6 10.6.6.1.8-.2.8-.5v-1.9c-3.1.7-3.7-1.5-3.7-1.5-.5-1.2-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.6 1.1 1.6 1.1 1 .1.7 1.7 2.6 1.2.1-.8.4-1.3.7-1.6-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3 .1.9-.2 1.8-.4 2.8-.4s1.9.1 2.8.4c2.1-1.4 3-.1 3-.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.4-2.6 5.3-5.1 5.6.4.3.8 1 .8 2v3c0 .3.2.6.8.5C19.8 21.2 23 17 23 12.1 23 5.9 18.1 1 12 1z"
				></path>
			</svg>
		</span>
		Continue with GitHub
	</a>
</div>

<style>
	.oauth-btns {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.75rem;
		width: 100%;
		max-width: 18rem;
		margin-inline: auto;
	}

	.oauth-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		border-radius: 999px;
		padding: 0.7rem 1.15rem;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--page-fg);
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.oauth-btn__icon {
		display: inline-flex;
		flex-shrink: 0;
		line-height: 0;
	}

	.oauth-btn--google {
		border: 1px solid var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
	}

	.oauth-btn--google:hover {
		background: color-mix(in srgb, var(--color-amber) 22%, transparent);
	}

	.oauth-btn--github {
		border: 1px solid color-mix(in srgb, var(--page-fg) 28%, transparent);
		background: transparent;
	}

	.oauth-btn--github:hover {
		border-color: var(--color-amber);
		color: var(--color-amber);
	}
</style>
