---
/** Text-size controls: a faint "Aa" that opens on hover, focus or tap. */
---

<div class="text-size-control" role="group" aria-label="Text size" data-text-size-control>
	<span class="text-size-label" aria-hidden="true">Aa</span>
	<span class="text-size-btns">
	<button
		type="button"
		class="text-size-btn"
		data-text-size-decrease
		aria-label="Decrease text size"
		title="Smaller text"
	>
		−
	</button>
	<button
		type="button"
		class="text-size-btn text-size-btn-reset"
		data-text-size-reset
		aria-label="Reset text size to default"
		title="Default text size"
		aria-pressed="true"
	>
		A
	</button>
	<button
		type="button"
		class="text-size-btn"
		data-text-size-increase
		aria-label="Increase text size"
		title="Larger text"
	>
		+
	</button>
	</span>
</div>
