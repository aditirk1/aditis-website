---
/**
 * Portfolio homepage (the default theme): one sideways-scrolling row of
 * panels inside a hairline frame. Vertical wheel and trackpad input moves it
 * sideways (scripts/portfolio-home.ts); touch swipes natively. Shown only when
 * html[data-theme='portfolio']; Orbit and Flow keep their own homepage.
 *
 * Every word comes from src/data/home.json (Decap: Site pages, Home page) or
 * the projects and blog collections, so it is edited once for all themes.
 */
import '../../styles/portfolio-home.css';
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import { loadBlogPosts } from '../../utils/blog.ts';

const pf = home.portfolio;
const projects = (await getCollection('projects', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = (await loadBlogPosts()).slice(0, 4);

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const pad = (n: number) => String(n).padStart(2, '0');
const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const year = new Date().getFullYear();

/* "Biomedical / engineer, / researcher, / writer." from the shared taglines. */
const taglines = (home.taglines ?? []).filter(Boolean) as string[];
const [first = '', ...rest] = taglines;
const last = rest.pop() ?? '';
const firstWords = cap(first).split(' ');
const lines = [...firstWords.slice(0, -1), `${firstWords.at(-1)},`, ...rest.map((t) => `${t},`)];

const labels = [...pf.labels];
if (labels.length) labels[labels.length - 1] = `${labels.at(-1)}, ${year}`;

const quoteWords = pf.about_quote.trim().split(' ');
const quoteEnd = quoteWords.pop() ?? '';

const sections = ['Index', pf.work_heading, pf.writing_heading, home.about_heading, pf.contact_heading.replace(/\.$/, '')];
---

<section class="pfh" data-portfolio-home aria-label="Portfolio">
	<div class="pfh-frame" aria-hidden="true">
		<span class="pfh-cross pfh-cross--tl"></span>
		<span class="pfh-cross pfh-cross--tr"></span>
		<span class="pfh-cross pfh-cross--bl"></span>
		<span class="pfh-cross pfh-cross--br"></span>
		<span class="pfh-rail pfh-rail--left">aditirk.me</span>
		<span class="pfh-rail pfh-rail--right">Portfolio, {year}</span>
	</div>

	<div class="pfh-scroller" data-pfh-scroller>
		<div class="pfh-track">
			<section class="pfh-panel pfh-hero" data-pfh-panel data-pfh-label={`01 ${sections[0]}`} aria-labelledby="pfh-title">
				<div class="pfh-hero__labels">
					{labels.map((l, i) => <p class="pfh-label pfh-fade" style={`--i: ${i}`}>{l}</p>)}
				</div>
				<h1 id="pfh-title" class="pfh-display pfh-hero__title">
					{lines.map((w, i) => <span class="pfh-hero__line pfh-rise" style={`--i: ${i}`}>{w}</span>)}
					<span class="pfh-hero__line pfh-rise" style={`--i: ${lines.length}`}><em>{last}.</em></span>
				</h1>
				<div class="pfh-hero__aside pfh-fade" style="--i: 4">
					<p class="pfh-hero__desc">{home.hero_description}</p>
					<div class="pfh-actions">
						<a class="pfh-button" href="#pfh-work">
							{home.cta_primary_label}
							<span class="pfh-arrow" aria-hidden="true">→</span>
						</a>
						<a class="pfh-link pfh-link--rest" href={home.cta_secondary_href}>{home.cta_secondary_label}</a>
					</div>
				</div>
				<p class="pfh-hero__note pfh-annot pfh-fade" style="--i: 5">{pf.note}</p>
			</section>

			<section class="pfh-panel pfh-intro" id="pfh-work" data-pfh-panel data-pfh-label={`02 ${sections[1]}`} aria-labelledby="pfh-work-title">
				<span class="pfh-label pfh-num">02</span>
				<h2 id="pfh-work-title" class="pfh-display pfh-intro__title">{pf.work_heading}</h2>
				<p class="pfh-label">{pad(projects.length)} projects</p>
				<a class="pfh-link pfh-link--rest pfh-intro__all" href="/projects">All projects</a>
			</section>

			{
				projects.map((p, i) => (
					<article class:list={['pfh-panel pfh-card', i === 0 && 'pfh-card--lead']} data-pfh-panel data-pfh-label={`02 ${sections[1]}`}>
						<a class="pfh-card__link" href={`/projects/${p.id}`}>
							<span class="pfh-card__top">
								<span class="pfh-label pfh-num">{pad(i + 1)}</span>
								<span class="pfh-label">{monthYear(p.data.date)}</span>
							</span>
							<span class="pfh-display pfh-card__title">{p.data.title}</span>
							<span class="pfh-card__summary">{p.data.summary}</span>
							<span class="pfh-card__foot">
								<span class="pfh-label">{p.data.tags.map(cap).join(', ')}</span>
								<span class="pfh-card__go">
									View <span class="pfh-arrow" aria-hidden="true">→</span>
								</span>
							</span>
						</a>
					</article>
				))
			}

			<section class="pfh-panel pfh-writing" id="pfh-writing" data-pfh-panel data-pfh-label={`03 ${sections[2]}`} aria-labelledby="pfh-writing-title">
				<span class="pfh-label pfh-num">03</span>
				<h2 id="pfh-writing-title" class="pfh-display pfh-intro__title">{pf.writing_heading}</h2>
				{
					posts.length ? (
						<ul class="pfh-posts">
							{posts.map((post) => (
								<li>
									<a href={post.href}>
										<span class="pfh-display pfh-posts__title">{post.entry.data.title}</span>
										<span class="pfh-label">{monthYear(post.entry.data.date)}</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="pfh-annot pfh-writing__empty">{pf.writing_empty}</p>
					)
				}
				<a class="pfh-link pfh-link--rest" href="/blog">All writing</a>
			</section>

			<section class="pfh-panel pfh-about" data-pfh-panel data-pfh-label={`04 ${sections[3]}`} aria-labelledby="pfh-about-title">
				<span class="pfh-label pfh-num">04</span>
				<h2 id="pfh-about-title" class="pfh-display pfh-intro__title">{home.about_heading}</h2>
				<p class="pfh-display pfh-quote">
					<span class="pfh-muted">…</span>{quoteWords.join(' ')} <em>{quoteEnd}</em>
				</p>
				<dl class="pfh-facts">
					{
						pf.facts.map((f) => (
							<div>
								<dt class="pfh-label">{f.label}</dt>
								<dd class="pfh-annot">{f.value}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section class="pfh-panel pfh-about-text" data-pfh-panel data-pfh-label={`04 ${sections[3]}`} aria-label={home.about_heading}>
				{home.about_paragraphs.map((para) => <p>{para}</p>)}
				<a class="pfh-link pfh-link--rest" href={home.resume_href}>{home.resume_label}</a>
			</section>

			<section class="pfh-panel pfh-contact" data-pfh-panel data-pfh-label={`05 ${sections[4]}`} aria-labelledby="pfh-contact-title">
				<span class="pfh-label pfh-num">05</span>
				<a id="pfh-contact-title" class="pfh-display pfh-contact__cta" href={home.cta_secondary_href}>{pf.contact_heading}</a>
				<div class="pfh-contact__cols">
					<div>
						<p class="pfh-label">Elsewhere</p>
						<a class="pfh-link" href="https://www.linkedin.com/in/aditirk/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
						<a class="pfh-link" href="https://github.com/aditirk1" target="_blank" rel="noopener noreferrer">GitHub</a>
						<a class="pfh-link" href={home.resume_href}>Résumé (PDF)</a>
					</div>
					<div>
						<p class="pfh-label">© {year}, aditirk.me</p>
					</div>
				</div>
			</section>
		</div>
	</div>

	<div class="pfh-status" aria-hidden="true">
		<span class="pfh-label" data-pfh-section>01 {sections[0]}</span>
		<span class="pfh-progress"><span data-pfh-progress></span></span>
		<span class="pfh-label pfh-status__hint" data-pfh-hint>Scroll <span class="pfh-arrow">→</span></span>
	</div>
</section>

<script>
	import { initPortfolioHome } from '../../scripts/portfolio-home.ts';
	initPortfolioHome();
</script>
