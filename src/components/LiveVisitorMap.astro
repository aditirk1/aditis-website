---
/**
 * Visitor widget: marble globe + total (same for Universe and Beach).
 *
 * The hover callout and leader line live in this template on purpose — Astro
 * scopes <style> to elements rendered here, so nodes created in JS would come
 * out unstyled.
 */
const apiBase = (import.meta.env.PUBLIC_VISITOR_API_BASE ?? '').replace(/\/$/, '');
---

<aside
	class="visitor-reach pointer-events-auto mt-8 md:mt-10"
	data-live-visitor-map
	data-api-base={apiBase}
	aria-label="Visitors"
>
	<div class="mb-3 flex items-center gap-2 text-[10px] uppercase tracking-[0.22em] text-[var(--page-muted)]">
		<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--color-amber)]" aria-hidden="true"
		></span>
		<span>Visitors</span>
	</div>

	<div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
		<div class="flex w-full min-w-0 flex-1 flex-col items-center gap-2">
			<span class="text-[9px] uppercase tracking-wider text-[var(--page-muted)]">By region</span>

			<div class="visitor-globe-stage" data-globe-stage>
				<div class="visitor-globe-circle">
					<div
						data-visitor-globe
						class="absolute inset-0 [&_canvas]:!block"
						role="img"
						aria-label="Globe showing visitor regions"
					>
					</div>
				</div>

				<svg class="visitor-globe-leader" data-globe-leader aria-hidden="true"></svg>

				<div class="visitor-globe-callout" data-globe-callout hidden>
					<span class="visitor-globe-callout__place" data-globe-callout-place></span>
					<span class="visitor-globe-callout__count" data-globe-callout-count></span>
				</div>
			</div>

			<p class="text-[10px] text-[var(--page-muted)] opacity-80">
				Hover a pin · scroll or pinch to zoom
			</p>
		</div>

		<div class="flex w-full min-w-0 flex-col items-center gap-2 sm:w-[200px] sm:shrink-0 sm:items-start">
			<span class="text-[9px] uppercase tracking-wider text-[var(--page-muted)]">Total</span>
			<div
				class="flex min-h-[72px] w-full max-w-[260px] flex-col justify-center gap-1 rounded-lg border border-[color-mix(in_srgb,var(--color-amber)_35%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_55%,transparent)] px-4 py-3 backdrop-blur-sm"
			>
				<span
					data-visitor-total
					class="text-2xl font-semibold tabular-nums text-[var(--color-amber)]"
					style="font-family: var(--font-mono, ui-monospace, monospace)">—</span>
			</div>
			<p data-visitor-note class="max-w-xs text-[10px] leading-snug text-[var(--page-muted)] opacity-90"></p>
		</div>
	</div>
</aside>

<style>
	/* Stage is wider than the globe so callout labels have somewhere to land. */
	.visitor-globe-stage {
		position: relative;
		width: 100%;
		max-width: 420px;
		height: 244px;
	}

	.visitor-globe-circle {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 200px;
		height: 200px;
		transform: translate(-50%, -50%);
		overflow: hidden;
		border-radius: 9999px;
		border: 1px solid color-mix(in srgb, var(--color-amber) 45%, transparent);
		box-shadow: 0 0 40px color-mix(in srgb, var(--color-amber) 18%, transparent);
	}

	@media (min-width: 640px) {
		.visitor-globe-stage {
			height: 264px;
		}

		.visitor-globe-circle {
			width: 220px;
			height: 220px;
		}
	}

	.visitor-globe-leader {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 15;
		pointer-events: none;
		overflow: visible;
		/* Children use currentColor, so they follow the theme accent. */
		color: var(--color-amber);
	}

	.visitor-globe-callout {
		position: absolute;
		z-index: 20;
		pointer-events: none;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		max-width: 132px;
		padding: 0.3rem 0.5rem;
		border-radius: 0.35rem;
		border: 1px solid color-mix(in srgb, var(--color-amber) 42%, transparent);
		background: color-mix(in srgb, var(--page-bg) 92%, transparent);
		box-shadow: 0 6px 20px color-mix(in srgb, #000 30%, transparent);
	}

	.visitor-globe-callout[hidden] {
		display: none;
	}

	.visitor-globe-callout__place {
		font-family: var(--font-display, system-ui, sans-serif);
		font-size: 0.68rem;
		font-weight: 500;
		line-height: 1.2;
		color: var(--page-fg);
		opacity: 0.92;
	}

	.visitor-globe-callout__count {
		font-family: var(--font-mono, ui-monospace, monospace);
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		color: var(--color-amber);
	}

</style>

<script>
	import { bootLiveVisitorMap } from '../scripts/live-visitor-map';

	const root = document.querySelector('[data-live-visitor-map]');
	let stop: (() => void) | undefined;
	if (root instanceof HTMLElement) {
		stop = bootLiveVisitorMap(root);
	}
	if (import.meta.hot) {
		import.meta.hot.dispose(() => stop?.());
	}
</script>
