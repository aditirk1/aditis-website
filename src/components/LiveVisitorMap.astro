---
/**
 * Theme-twin visitor widget:
 *   Universe → marble globe
 *   Beach    → 2D map with hoverable pins
 */
const apiBase = (import.meta.env.PUBLIC_VISITOR_API_BASE ?? '').replace(/\/$/, '');
---

<aside
	class="visitor-reach pointer-events-auto mt-8 md:mt-10"
	data-live-visitor-map
	data-api-base={apiBase}
	aria-label="Visitors"
>
	<div class="mb-3 flex items-center gap-2 text-[10px] uppercase tracking-[0.22em] text-[var(--page-muted)]">
		<span class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--color-amber)]" aria-hidden="true"
		></span>
		<span>Visitors</span>
	</div>

	<div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
		<div class="visitor-reach__universe flex flex-col items-center gap-2" data-reach-universe>
			<span class="text-[9px] uppercase tracking-wider text-[var(--page-muted)]">By country</span>
			<div
				class="relative h-[200px] w-[200px] shrink-0 overflow-hidden rounded-full border border-[color-mix(in_srgb,var(--color-amber)_45%,transparent)] shadow-[0_0_40px_color-mix(in_srgb,var(--color-amber)_18%,transparent)] sm:h-[220px] sm:w-[220px]"
			>
				<div
					data-visitor-globe
					class="absolute inset-0 [&_canvas]:!block"
					role="img"
					aria-label="Globe showing visitor countries"
				>
				</div>
			</div>
			<p class="text-[10px] text-[var(--page-muted)] opacity-80">Hover a pin for the count</p>
		</div>

		<div class="visitor-reach__beach flex w-full flex-col items-center gap-2 sm:max-w-[300px]" data-reach-beach>
			<span class="text-[9px] uppercase tracking-wider text-[var(--page-muted)]">By country</span>
			<div
				class="visitor-horizon-frame relative h-[168px] w-full max-w-[300px] overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--color-amber)_30%,transparent)] shadow-[0_12px_36px_color-mix(in_srgb,var(--color-amber)_12%,transparent)] sm:h-[190px]"
			>
				<div
					data-visitor-horizon
					class="absolute inset-0"
					role="img"
					aria-label="Map showing visitor countries"
				>
				</div>
			</div>
			<p class="text-[10px] text-[var(--page-muted)] opacity-80">Hover a pin for the count</p>
		</div>

		<div class="flex w-full min-w-0 flex-1 flex-col items-center gap-2 sm:items-start">
			<span class="text-[9px] uppercase tracking-wider text-[var(--page-muted)]">Total</span>
			<div
				class="flex min-h-[72px] w-full max-w-[260px] flex-col justify-center gap-1 rounded-lg border border-[color-mix(in_srgb,var(--color-amber)_35%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_55%,transparent)] px-4 py-3 backdrop-blur-sm"
			>
				<span
					data-visitor-total
					class="text-2xl font-semibold tabular-nums text-[var(--color-amber)]"
					style="font-family: var(--font-mono, ui-monospace, monospace)">—</span>
			</div>
			<p data-visitor-note class="max-w-xs text-[10px] leading-snug text-[var(--page-muted)] opacity-90"></p>
		</div>
	</div>
</aside>

<style>
	html[data-theme='universe'] [data-reach-beach] {
		display: none !important;
	}

	html[data-theme='beach'] [data-reach-universe] {
		display: none !important;
	}

	.visitor-horizon__svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.visitor-horizon__tooltip {
		position: absolute;
		z-index: 5;
		pointer-events: none;
		transform: translate(-50%, calc(-100% - 8px));
		padding: 0.35rem 0.55rem;
		border-radius: 0.4rem;
		border: 1px solid color-mix(in srgb, var(--color-amber) 40%, transparent);
		background: color-mix(in srgb, var(--page-bg) 92%, transparent);
		color: var(--page-fg);
		font-size: 0.7rem;
		line-height: 1.25;
		white-space: nowrap;
		box-shadow: 0 8px 24px color-mix(in srgb, #000 18%, transparent);
		opacity: 0;
		transition: opacity 120ms ease;
	}

	.visitor-horizon__tooltip[data-show='1'] {
		opacity: 1;
	}
</style>

<script>
	import { bootLiveVisitorMap } from '../scripts/live-visitor-map';

	const root = document.querySelector('[data-live-visitor-map]');
	let stop: (() => void) | undefined;
	if (root instanceof HTMLElement) {
		stop = bootLiveVisitorMap(root);
	}
	if (import.meta.hot) {
		import.meta.hot.dispose(() => stop?.());
	}
</script>
