---
/**
 * Floating audio controls with collapse toggle (persisted in localStorage).
 */
const collapseKey = 'aditi-ambient-panel-collapsed';
---

<div class="pointer-events-auto fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-1.5" data-ambient-root>
	<button
		type="button"
		class="rounded-full border border-[color-mix(in_srgb,var(--color-amber)_40%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_90%,transparent)] px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-[var(--page-fg)] shadow backdrop-blur-sm transition hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
		data-ambient-toggle
		aria-expanded="true"
		aria-controls="ambient-panel-body"
	>
		<span data-ambient-toggle-label>Hide</span>
	</button>
	<div
		id="ambient-panel-body"
		class="flex max-w-[240px] flex-col gap-2.5 rounded-2xl border border-[color-mix(in_srgb,var(--color-amber)_35%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_88%,transparent)] p-3.5 text-sm text-[var(--page-fg)] shadow-lg backdrop-blur-md transition-[opacity,transform]"
		data-ambient-panel
		aria-label="Ambient sound controls"
	>
		<div class="flex items-center justify-between gap-2">
			<button
				type="button"
				class="rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_20%,transparent)] px-2.5 py-1.5 text-sm hover:border-[var(--color-amber)]"
				data-audio-mute-toggle
				aria-pressed="false"
			>
				<span data-audio-mute-label>Sound on</span>
			</button>
			<span class="text-[var(--page-muted)]" aria-hidden="true">♪</span>
		</div>
		<label class="flex flex-col gap-1">
			<span class="text-[var(--page-muted)]">Volume</span>
			<input type="range" min="0" max="100" value="15" class="w-full accent-[var(--color-amber)]" data-audio-volume-slider />
		</label>
		<label class="flex flex-col gap-1">
			<span class="text-[var(--page-muted)]">Ambience</span>
			<select
				class="rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_18%,transparent)] bg-transparent px-2.5 py-1.5 text-sm"
				data-audio-track-select
			>
			</select>
		</label>
	</div>
</div>

<script define:vars={{ collapseKey }}>
	var root = document.querySelector('[data-ambient-root]');
	var panel = document.querySelector('[data-ambient-panel]');
	var toggle = document.querySelector('[data-ambient-toggle]');
	var label = document.querySelector('[data-ambient-toggle-label]');

	/* The panel is fixed over the page, so on small or short screens it starts
	   collapsed rather than covering content. An explicit choice always wins. */
	function readCollapsed() {
		try {
			var stored = localStorage.getItem(collapseKey);
			if (stored === '1') return true;
			if (stored === '0') return false;
		} catch (e) {
			/* fall through to the viewport default */
		}
		return window.innerWidth < 768 || window.innerHeight < 600;
	}

	function setCollapsed(collapsed, persist) {
		if (persist) {
			try {
				localStorage.setItem(collapseKey, collapsed ? '1' : '0');
			} catch (e) {
				/* ignore */
			}
		}
		if (!panel || !toggle || !label) return;
		panel.style.display = collapsed ? 'none' : '';
		panel.setAttribute('aria-hidden', collapsed ? 'true' : 'false');
		toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
		label.textContent = collapsed ? 'Sound' : 'Hide';
	}

	if (root && panel && toggle) {
		setCollapsed(readCollapsed(), false);
		toggle.addEventListener('click', function () {
			var isHidden = panel.style.display === 'none';
			setCollapsed(!isHidden, true);
		});
	}
</script>

<script>
	import { initAmbientAudio } from '../scripts/ambient-audio.ts';

	const stop = initAmbientAudio();

	if (import.meta.hot) {
		import.meta.hot.dispose(() => stop());
	}
</script>
