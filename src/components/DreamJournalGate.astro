---
/**
 * Dream journal gate: quiz → Google/GitHub OAuth → content from /api/dreams.
 * Slot content is a client-filled shell — no dream HTML in the static build.
 */
import OAuthSignInButtons from './OAuthSignInButtons.astro';
---

<div class="dream-gate-root" data-dream-gate-root data-dream-locked="1">
	<div
		class="dream-gate-panel dream-realm-panel pointer-events-auto mx-auto max-w-md rounded-2xl px-6 py-8 md:px-8 md:py-10"
		data-dream-gate
		data-dream-gate-panel
	>
		<div data-dream-gate-form-wrap>
			<h2
				class="mb-6 text-center text-3xl font-light md:text-4xl"
				style="font-family: var(--font-display)"
			>
				One question
			</h2>

			<form class="flex flex-col gap-4" data-dream-gate-form autocomplete="off">
				<label class="flex flex-col gap-2 text-sm text-[var(--page-muted)]">
					<span data-dream-gate-question class="text-center text-base text-[var(--page-fg)]"></span>
					<input
						type="text"
						name="answer"
						data-dream-gate-input
						class="rounded-lg border border-[color-mix(in_srgb,var(--color-amber)_30%,transparent)] bg-[color-mix(in_srgb,#000_30%,transparent)] px-3 py-2.5 text-[var(--page-fg)] outline-none transition focus:border-[var(--color-amber)]"
						placeholder="Your answer"
						spellcheck="false"
						autocapitalize="off"
						autocomplete="off"
						required
					/>
				</label>
				<p data-dream-gate-error class="text-sm text-[color-mix(in_srgb,#ff8a8a_90%,white)]" hidden></p>
				<div class="flex flex-wrap items-center justify-center gap-3">
					<button
						type="submit"
						class="rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_12%,transparent)] px-5 py-2.5 text-sm font-semibold text-[var(--page-fg)] transition hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)]"
					>
						Enter
					</button>
					<button
						type="button"
						data-dream-gate-rotate
						class="text-sm text-[var(--page-muted)] underline-offset-2 hover:text-[var(--color-amber)] hover:underline"
					>
						Different question
					</button>
				</div>
			</form>
		</div>

		<div data-dream-gate-auth class="dream-gate-auth" hidden>
			<h2 class="dream-gate-auth__title m-0" style="font-family: var(--font-display)">Sign in</h2>
			<OAuthSignInButtons
				googleHref="/api/dream-auth?provider=google&return_to=%2Fdream-journal"
				githubHref="/api/dream-auth?provider=github&return_to=%2Fdream-journal"
			/>
		</div>

		<div class="dream-gate-lockout" data-dream-gate-lockout hidden>
			<div class="dream-gate-lockout-stack">
				<p class="dream-gate-lockout-title m-0">Locked</p>
				<a href="/" class="dream-gate-lockout-home">
					Head back home{' '}
					<span class="dream-gate-home-emoji dream-gate-home-emoji--universe" aria-hidden="true">🪐</span>
					<span class="dream-gate-home-emoji dream-gate-home-emoji--beach" aria-hidden="true">🌊</span>
				</a>
			</div>
		</div>
	</div>

	<div data-dream-gate-content hidden>
		<slot />
	</div>
</div>

<script>
	import { initDreamJournalGate } from '../scripts/dream-journal-gate.ts';

	const root = document.querySelector('[data-dream-gate-root]');
	let stop: (() => void) | undefined;
	if (root instanceof HTMLElement) {
		stop = initDreamJournalGate(root);
	}
	if (import.meta.hot) {
		import.meta.hot.dispose(() => stop?.());
	}
</script>

<style>
	.dream-gate-root[data-dream-locked] [data-dream-gate-content] {
		display: none;
	}

	.dream-gate-root:not([data-dream-locked]) [data-dream-gate] {
		display: none;
	}

	.dream-gate-root[data-dream-lockout] [data-dream-gate-form-wrap],
	.dream-gate-root[data-dream-auth] [data-dream-gate-form-wrap] {
		display: none;
	}

	.dream-gate-root[data-dream-lockout] [data-dream-gate-auth] {
		display: none;
	}

	.dream-gate-root[data-dream-lockout] .dream-gate-panel {
		max-width: none;
		margin-top: 0;
		background: transparent;
		border: none;
		box-shadow: none;
		padding: 0;
	}

	.dream-gate-panel {
		margin-top: clamp(2rem, 8vh, 4rem);
	}

	.dream-gate-auth {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
		padding: 0.5rem 0;
	}

	.dream-gate-auth__title {
		font-size: clamp(2rem, 6vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: var(--page-fg);
	}

	.dream-gate-lockout {
		display: flex;
		min-height: min(70vh, 36rem);
		align-items: center;
		justify-content: center;
		padding: 2rem 1rem;
	}

	.dream-gate-lockout-stack {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.65rem;
		text-align: center;
	}

	.dream-gate-lockout-title {
		font-family: var(--font-display);
		font-size: clamp(3rem, 12vw, 5.5rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--page-fg);
	}

	.dream-gate-lockout-home {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 4vw, 1.85rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--color-amber);
		text-decoration: none;
		underline-offset: 0.14em;
	}

	.dream-gate-lockout-home:hover,
	.dream-gate-lockout-home:focus-visible {
		text-decoration: underline;
	}

	.dream-gate-home-emoji--beach {
		display: none;
	}

	:global(html[data-theme='beach']) .dream-gate-home-emoji--universe {
		display: none;
	}

	:global(html[data-theme='beach']) .dream-gate-home-emoji--beach {
		display: inline;
	}

	@keyframes dream-gate-shake {
		0%,
		100% {
			transform: translateX(0);
		}
		15% {
			transform: translateX(-10px);
		}
		30% {
			transform: translateX(10px);
		}
		45% {
			transform: translateX(-8px);
		}
		60% {
			transform: translateX(8px);
		}
		75% {
			transform: translateX(-4px);
		}
		90% {
			transform: translateX(4px);
		}
	}

	:global(.dream-gate-shake) {
		animation: dream-gate-shake 0.45s ease-in-out;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.dream-gate-shake) {
			animation: none;
			outline: 2px solid color-mix(in srgb, #ff8a8a 70%, transparent);
		}
	}
</style>
