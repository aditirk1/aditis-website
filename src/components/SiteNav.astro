---
/**
 * SiteNav — primary tabs with a GSAP-powered amber underline that slides to the active link.
 * Dream Journal is hidden — discoverable via the secret star (universe) or Dreams button (beach).
 */
const pathname = Astro.url.pathname;

const links = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/photo-dump', label: 'Photo Dump' },
	{ href: '/thoughts', label: 'Thoughts' },
	{ href: '/services', label: 'Services' },
] as const;

function isActive(href: string): boolean {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
}
---

<nav class="relative hidden md:block" aria-label="Primary" data-site-nav>
	<ul class="relative flex flex-wrap items-center justify-end gap-x-6 gap-y-2 text-sm font-medium">
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						class:list={[
							'nav-tab text-[var(--page-fg)] transition-colors hover:text-[var(--color-amber)]',
							isActive(href) && 'text-[var(--color-amber)]',
						]}
						data-nav-href={href}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	<span
		class="pointer-events-none absolute -bottom-1 left-0 h-0.5 rounded-full bg-[var(--color-amber)]"
		data-nav-underline
		aria-hidden="true"></span>
</nav>

<!-- Compact nav for small screens -->
<nav class="mt-3 md:hidden" aria-label="Primary mobile" data-site-nav-mobile>
	<ul class="flex flex-wrap gap-2 text-xs">
		{
			links.map(({ href, label }) => (
				<li>
					<a
						href={href}
						data-nav-href={href}
						class:list={[
							'rounded-full border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] px-2.5 py-1',
							isActive(href) && 'border-[var(--color-amber)] text-[var(--color-amber)]',
						]}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
