---
/**
 * Primary site navigation (one list — desktop + mobile).
 * Mobile: horizontal scroll. Desktop: inline flex row.
 */
const isHome = Astro.url.pathname === '/';

const links = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/photo-dump', label: 'Photo Dump' },
	{ href: '/thoughts', label: 'Thoughts' },
	{ href: '/services', label: 'Services' },
];
---

<nav class="min-w-0 md:w-auto" aria-label="Primary" data-home={isHome ? 'true' : 'false'}>
	<div class="site-nav-links" data-site-nav data-site-nav-mobile>
		{links.map((link) => (
			<a class="nav-tab" data-nav-href={link.href} href={link.href}>
				{link.label}
			</a>
		))}
	</div>
</nav>
