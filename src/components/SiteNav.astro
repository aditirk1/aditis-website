---
/**
 * Primary site navigation (desktop + mobile).
 */
const isHome = Astro.url.pathname === '/';
---

<nav class="w-full md:w-auto" aria-label="Primary" data-home={isHome ? 'true' : 'false'}>
	<div
		class="site-nav-desktop relative hidden items-center md:flex"
		data-site-nav
	>
		<a href="/projects" class="nav-tab">Projects</a>
		<a href="/blog" class="nav-tab">Blog</a>
		<a href="/photo-dump" class="nav-tab">Photo Dump</a>
		<a href="/thoughts" class="nav-tab">Thoughts</a>
		<a href="/services" class="nav-tab">Services</a>
	</div>

	<div class="flex flex-wrap items-center justify-end gap-2 text-[0.78rem] sm:text-[0.72rem] md:hidden" data-site-nav-mobile>
		<a class="nav-tab" data-nav-href="/projects" href="/projects">Projects</a>
		<a class="nav-tab" data-nav-href="/blog" href="/blog">Blog</a>
		<a class="nav-tab" data-nav-href="/photo-dump" href="/photo-dump">Photo Dump</a>
		<a class="nav-tab" data-nav-href="/thoughts" href="/thoughts">Thoughts</a>
		<a class="nav-tab" data-nav-href="/services" href="/services">Services</a>
	</div>
</nav>
