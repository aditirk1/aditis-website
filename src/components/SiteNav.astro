---
/**
 * Primary site navigation (desktop + mobile).
 *
 * Every section is always listed. Sections without content yet show a themed
 * placeholder rather than disappearing from the nav.
 */
const isHome = Astro.url.pathname === '/';

const links = [
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/photo-dump', label: 'Photo Dump' },
	{ href: '/thoughts', label: 'Thoughts' },
	{ href: '/services', label: 'Services' },
];
---

<nav class="w-full md:w-auto" aria-label="Primary" data-home={isHome ? 'true' : 'false'}>
	<div class="site-nav-desktop relative hidden items-center md:flex" data-site-nav>
		{links.map((link) => <a href={link.href} class="nav-tab">{link.label}</a>)}
	</div>

	<div
		class="flex flex-wrap items-center justify-end gap-2 text-[0.78rem] sm:text-[0.72rem] md:hidden"
		data-site-nav-mobile
	>
		{links.map((link) => (
			<a class="nav-tab" data-nav-href={link.href} href={link.href}>{link.label}</a>
		))}
	</div>
</nav>
