---
/**
 * Global shell: theme FOUC guard, fonts, Lenis + ScrollTrigger, backgrounds,
 * navigation, ambient audio, Umami (optional), and page-wide GSAP reveals.
 */
import '../styles/global.css';
import StarFieldUniverse from '../components/StarFieldUniverse.astro';
import BeachBackground from '../components/BeachBackground.astro';
import SiteNav from '../components/SiteNav.astro';
import AmbientAudio from '../components/AmbientAudio.astro';

interface Props {
	title?: string;
	description?: string;
	layoutVariant?: 'default' | 'dream';
	/** When true, adds robots noindex (use for private admin-style pages). */
	noindex?: boolean;
}

const {
	title = "aditi's universe",
	description = 'Biomedical engineer, researcher, freelancer, writer — aditirk.me',
	layoutVariant = 'default',
	noindex = false,
} = Astro.props;

const dreamRealm = layoutVariant === 'dream';

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
---

<!doctype html>
<html lang="en" data-layout={layoutVariant} data-dream-realm={dreamRealm ? '1' : undefined}>
	<head>
		<meta charset="utf-8" />
		<!-- Apply saved theme before first paint so Beach ↔ Beach navigations never flash Universe -->
		<script is:inline>
			(function () {
				try {
					var t = localStorage.getItem('aditi-theme');
					document.documentElement.setAttribute('data-theme', t === 'beach' ? 'beach' : 'universe');
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'universe');
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Inter:wght@300;400;500;600;700&family=Bangers&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{umamiId && umamiSrc && <script defer src={umamiSrc} data-website-id={umamiId} />}

		<style is:global>
			:root {
				--font-display: 'Inter', system-ui, sans-serif;
				--font-body: 'Cormorant Garamond', 'Georgia', serif;
				--font-dream-comic: 'Bangers', 'Inter', cursive;
				--font-mono: 'IBM Plex Mono', ui-monospace, monospace;
			}
		</style>
	</head>
	<body class="relative antialiased">
		<div class="universe-nebula-overlay" aria-hidden="true"></div>

		<StarFieldUniverse />
		<BeachBackground />

		<div id="site-shell" class="relative z-10 flex min-h-dvh flex-col pointer-events-none">
			<header
				class="pointer-events-auto flex flex-col gap-3 px-6 py-5 transition-[padding,backdrop-filter] duration-300 md:flex-row md:items-center md:justify-between md:gap-6 md:px-10"
				data-site-header
			>
				<a
					href="/"
					class="shrink-0 text-lg font-bold tracking-tight text-[var(--page-fg)] md:text-xl"
					style="font-family: var(--font-display)"
				>
					aditi's universe
				</a>

				<div class="flex w-full flex-col items-stretch gap-3 md:w-auto md:max-w-none md:flex-row md:items-center md:justify-end">
					<SiteNav />
					<button
						type="button"
						class="shrink-0 self-end rounded-full border border-[color-mix(in_srgb,var(--color-amber)_35%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_75%,transparent)] px-3 py-1 text-xs font-semibold text-[var(--page-fg)] backdrop-blur-sm transition hover:border-[var(--color-amber)] hover:text-[var(--color-amber)] md:self-center"
						data-theme-toggle
						aria-label="Toggle Universe and Beach theme"
					>
						<span data-theme-toggle-label>Universe</span>
					</button>
				</div>
			</header>

			<main class="pointer-events-none flex-1 px-6 pb-24 md:px-10">
				<slot />
			</main>
		</div>

		<AmbientAudio />

		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			import { initPageRevealAnimations } from '../scripts/page-reveal.ts';
			import { syncSiteNavChrome } from '../scripts/site-nav.ts';

			const html = document.documentElement;
			const THEME_KEY = 'aditi-theme';

			function getStoredTheme(): 'universe' | 'beach' {
				const v = localStorage.getItem(THEME_KEY);
				return v === 'beach' ? 'beach' : 'universe';
			}

			function applyTheme(theme: 'universe' | 'beach') {
				html.setAttribute('data-theme', theme);
				localStorage.setItem(THEME_KEY, theme);
				const label = document.querySelector('[data-theme-toggle-label]');
				if (label) label.textContent = theme === 'universe' ? 'Universe' : 'Beach';
			}

			function onThemeToggleClick(e: MouseEvent) {
				const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
				if (!btn) return;
				const next = html.getAttribute('data-theme') === 'universe' ? 'beach' : 'universe';
				applyTheme(next);
			}

			applyTheme(getStoredTheme());
			syncSiteNavChrome();
			document.addEventListener('click', onThemeToggleClick);

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reduceMotion) {
				gsap.registerPlugin(ScrollTrigger);

				const lenis = new Lenis({
					duration: 1.15,
					smoothWheel: true,
					touchMultiplier: 1.35,
				});

				ScrollTrigger.scrollerProxy(document.body, {
					scrollTop(value) {
						if (arguments.length && typeof value === 'number') {
							lenis.scrollTo(value, { immediate: true });
						}
						return lenis.scroll;
					},
					getBoundingClientRect() {
						return {
							top: 0,
							left: 0,
							width: window.innerWidth,
							height: window.innerHeight,
						};
					},
				});

				lenis.on('scroll', ScrollTrigger.update);

				gsap.ticker.add((time) => {
					lenis.raf(time * 1000);
				});
				gsap.ticker.lagSmoothing(0);
			}

			let stopReveal = initPageRevealAnimations();

			const header = document.querySelector('[data-site-header]') as HTMLElement | null;
			function onScrollHeader() {
				if (!header) return;
				const y = window.scrollY;
				if (y > 24) {
					header.style.paddingTop = '0.65rem';
					header.style.paddingBottom = '0.65rem';
					header.style.backdropFilter = 'blur(12px)';
					header.style.backgroundColor =
						html.getAttribute('data-theme') === 'beach'
							? 'color-mix(in srgb, var(--color-beach-bg) 78%, transparent)'
							: 'color-mix(in srgb, var(--color-universe-bg) 72%, transparent)';
				} else {
					header.style.paddingTop = '';
					header.style.paddingBottom = '';
					header.style.backdropFilter = '';
					header.style.backgroundColor = '';
				}
			}
			window.addEventListener('scroll', onScrollHeader, { passive: true });
			onScrollHeader();

			function onResizeNav() {
				syncSiteNavChrome();
			}

			window.addEventListener('resize', onResizeNav);

			if (import.meta.hot) {
				import.meta.hot.dispose(() => {
					stopReveal();
					document.removeEventListener('click', onThemeToggleClick);
					window.removeEventListener('resize', onResizeNav);
				});
			}
		</script>
	</body>
</html>
