---
/**
 * Global shell: theme, fonts, Lenis + ScrollTrigger, backgrounds, navigation.
 * Standard full-page loads only — stable and predictable (no client router).
 */
import '../styles/global.css';
import StarFieldUniverse from '../components/StarFieldUniverse.astro';
import BeachBackground from '../components/BeachBackground.astro';
import SiteNav from '../components/SiteNav.astro';
import TextSizeControl from '../components/TextSizeControl.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
	title?: string;
	description?: string;
	layoutVariant?: 'default' | 'dream';
	noindex?: boolean;
	/** Edge-to-edge main column (full-page articles) */
	immersive?: boolean;
}

const {
	title = "aditi's universe",
	description = 'Biomedical engineer, researcher, freelancer, writer — aditirk.me',
	layoutVariant = 'default',
	noindex = false,
	immersive = false,
} = Astro.props;

const dreamRealm = layoutVariant === 'dream';
const isHome = Astro.url.pathname === '/';

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImageURL = new URL('/brand/logo-universe-512.png', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-layout={layoutVariant} data-dream-realm={dreamRealm ? '1' : undefined}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(function () {
				try {
					var KEY = 'aditi-theme';
					var t = localStorage.getItem(KEY);
					if (t !== 'beach' && t !== 'universe') {
						t = Math.random() < 0.6 ? 'universe' : 'beach';
						localStorage.setItem(KEY, t);
					}
					document.documentElement.setAttribute('data-theme', t);
					var pref = t === 'beach' ? '/brand/logo-beach' : '/brand/logo-universe';
					var f16 = document.querySelector('link[data-favicon-16]');
					var f32 = document.querySelector('link[data-favicon-32]');
					var apple = document.querySelector('link[data-apple-touch-icon]');
					if (f16) f16.setAttribute('href', pref + '-16.png');
					if (f32) f32.setAttribute('href', pref + '-32.png');
					if (apple) apple.setAttribute('href', pref + '-180.png');
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'universe');
				}
				try {
					if (
						window.matchMedia &&
						(window.matchMedia('(hover: none)').matches ||
							window.matchMedia('(pointer: coarse)').matches ||
							window.innerWidth < 768)
					) {
						document.documentElement.setAttribute('data-coarse-pointer', '1');
					}
				} catch (e) {}
			})();
		</script>
		<script is:inline>
			(function () {
				try {
					var KEY = 'aditi-text-scale';
					var DEF = 1.1;
					var raw = localStorage.getItem(KEY);
					var s = raw !== null ? parseFloat(raw) : DEF;
					if (!isFinite(s) || s < 0.95 || s > 1.3) s = DEF;
					document.documentElement.style.setProperty('--reader-text-scale', String(s));
				} catch (e) {
					document.documentElement.style.setProperty('--reader-text-scale', '1.1');
				}
			})();
		</script>
		<script is:inline>
			(function () {
				var reduce =
					typeof window !== 'undefined' &&
					window.matchMedia &&
					window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!reduce) {
					document.documentElement.setAttribute('data-reveal-bootstrap', '1');
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL.href} />
		<meta property="og:type" content={isHome ? 'website' : 'article'} />
		<meta property="og:site_name" content="aditi's universe" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImageURL.href} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL.href} />
		<link rel="icon" type="image/png" sizes="16x16" href="/brand/logo-universe-16.png" data-favicon-16 />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/logo-universe-32.png" data-favicon-32 />
		<link rel="apple-touch-icon" sizes="180x180" href="/brand/logo-universe-180.png" data-apple-touch-icon />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="aditi's universe · blog"
			href="/rss.xml"
		/>
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Castoro:ital@0;1&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600;700;800&family=Bangers&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		{umamiId && umamiSrc && <script defer src={umamiSrc} data-website-id={umamiId} />}

		<style is:global>
			:root {
				--font-display: 'Inter', system-ui, sans-serif;
				--font-title: 'Inter', system-ui, sans-serif;
				--font-body: 'EB Garamond', 'Georgia', serif;
				--font-dream-comic: 'Bangers', 'Inter', cursive;
				--font-mono: 'IBM Plex Mono', ui-monospace, monospace;
			}

			html[data-reveal-bootstrap='1'] [data-reveal-stagger] [data-reveal-child] {
				opacity: 0;
				transform: translate3d(0, 0.75rem, 0);
				will-change: transform, opacity;
			}
		</style>
	</head>
	<body class="relative antialiased">
		<!-- If GSAP fails, force content visible after a short delay -->
		<script is:inline>
			(function () {
				function clearReveal() {
					try {
						document.documentElement.removeAttribute('data-reveal-bootstrap');
					} catch (e) {}
				}
				window.addEventListener('load', function () {
					setTimeout(clearReveal, 2800);
				});
			})();
		</script>

		<div class="dream-realm-tint" aria-hidden="true"></div>

		<!-- Beach before universe so its theme observer can release WebGL first. -->
		<BeachBackground />
		<StarFieldUniverse />

		<div id="site-shell" class="relative z-10 flex min-h-dvh flex-col pointer-events-none">
			<a href="#main-content" class="skip-link">Skip to content</a>
			<header
				class="site-header pointer-events-none flex flex-col gap-2 px-4 py-3 sm:px-6 sm:py-4 md:flex-row md:items-center md:gap-4 md:px-10 md:py-5"
				data-site-header
			>
				<div class="pointer-events-auto flex shrink-0 items-center gap-2.5 md:order-1">
					{
						isHome && (
							<button
								type="button"
								class="beach-dream-pineapple border-0 bg-transparent p-0 text-sm leading-none opacity-[0.32] transition duration-300 fine-hover:scale-110 fine-hover:opacity-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-amber)] focus-visible:ring-offset-2"
								data-beach-dream-journal
								aria-label="A quiet corner of the site"
								title=""
							>
								<span aria-hidden="true" class="select-none">🍍</span>
								<span class="sr-only">Open dream journal</span>
							</button>
						)
					}
					<a
						href="/"
						class="flex items-center gap-2 text-lg font-bold tracking-tight text-[var(--page-fg)] md:text-xl"
						style="font-family: var(--font-display)"
					>
						<img
							src="/brand/logo-universe-32.png"
							alt=""
							class="h-8 w-8 select-none md:h-9 md:w-9"
							decoding="async"
							loading="eager"
							data-site-logo
						/>
						Home
					</a>
				</div>

				<div
					class="pointer-events-auto flex w-full min-w-0 items-center gap-2 md:order-2 md:ml-auto md:w-auto md:flex-1 md:justify-end md:gap-3"
					data-site-nav-slot
				>
					<div class="min-w-0 flex-1 md:flex-none md:w-auto">
						<SiteNav />
					</div>
					<button
						type="button"
						class="theme-toggle-btn shrink-0 rounded-full border border-[color-mix(in_srgb,var(--color-amber)_35%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_75%,transparent)] px-2.5 py-1 text-[0.7rem] font-medium leading-none text-[var(--page-fg)] backdrop-blur-sm transition fine-hover:border-[var(--color-amber)] fine-hover:text-[var(--color-amber)] md:px-4 md:py-2 md:text-sm md:font-semibold"
						data-theme-toggle
						aria-label="Toggle Universe and Beach theme"
					>
						<span data-theme-toggle-label>Universe</span>
					</button>
				</div>
			</header>

			<main
				id="main-content"
				class:list={[
					'pointer-events-none flex-1',
					immersive ? 'px-0 pb-0' : 'px-6 pb-8 md:px-10',
				]}
				tabindex="-1"
			>
				<slot />
			</main>

			<SiteFooter />
		</div>

		<div class="pointer-events-auto fixed bottom-5 right-5 z-[60]" data-reader-tools>
			<TextSizeControl />
		</div>

		<script>
			import Lenis from 'lenis';
			import 'lenis/dist/lenis.css';
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';
			import { initPageRevealAnimations } from '../scripts/page-reveal.ts';
			import { syncSiteNavChrome } from '../scripts/site-nav.ts';
			import { syncHeroLayout } from '../scripts/hero-layout.ts';
			import {
				initScrollOrchestrator,
				publishScroll,
				refreshScrollMetrics,
				subscribeScroll,
			} from '../scripts/scroll-orchestrator.ts';
			import { initTextSizeControl } from '../scripts/text-size-control.ts';
			import { initHomeHero } from '../scripts/home-hero.ts';
			import { syncCoarsePointerAttribute } from '../utils/input-capabilities.ts';
			import { readStoredTheme, resolveTheme, THEME_KEY } from '../utils/theme-preference.ts';

			gsap.registerPlugin(ScrollTrigger);

			const html = document.documentElement;

			function syncBrandAssets(theme: 'universe' | 'beach') {
				const pref = theme === 'beach' ? '/brand/logo-beach' : '/brand/logo-universe';

				const link16 = document.querySelector('link[data-favicon-16]') as HTMLLinkElement | null;
				const link32 = document.querySelector('link[data-favicon-32]') as HTMLLinkElement | null;
				const apple = document.querySelector('link[data-apple-touch-icon]') as HTMLLinkElement | null;
				if (link16) link16.href = `${pref}-16.png`;
				if (link32) link32.href = `${pref}-32.png`;
				if (apple) apple.href = `${pref}-180.png`;

				const logo = document.querySelector('[data-site-logo]') as HTMLImageElement | null;
				if (logo) logo.src = `${pref}-32.png`;
			}

			function getStoredTheme(): 'universe' | 'beach' {
				return readStoredTheme() ?? resolveTheme();
			}

			function applyTheme(theme: 'universe' | 'beach') {
				html.setAttribute('data-theme', theme);
				syncBrandAssets(theme);
				syncHeroLayout(theme);
				/* Sync now so the orrery fade doesn't read a stale heroBottom=0. */
				refreshScrollMetrics();
				try {
					localStorage.setItem(THEME_KEY, theme);
				} catch {
					/* ignore */
				}
				const label = document.querySelector('[data-theme-toggle-label]');
				if (label) label.textContent = theme === 'universe' ? 'Universe' : 'Beach';
				/* Second pass after layout/fonts settle. */
				requestAnimationFrame(() => {
					refreshScrollMetrics();
					ScrollTrigger.refresh();
					lenis?.resize();
				});
			}

			function onThemeToggleClick(e: MouseEvent) {
				const btn = (e.target as HTMLElement).closest('[data-theme-toggle]');
				if (!btn) return;
				const next = html.getAttribute('data-theme') === 'universe' ? 'beach' : 'universe';
				applyTheme(next);
			}

			applyTheme(getStoredTheme());
			syncCoarsePointerAttribute();
			syncSiteNavChrome();
			document.addEventListener('click', onThemeToggleClick);
			const stopTextSizeControl = initTextSizeControl();

			/* Reader text size changes document height — trigger positions must follow. */
			function onTextSizeChange(e: MouseEvent) {
				if (!(e.target as HTMLElement).closest('[data-text-size-control]')) return;
				requestAnimationFrame(() => {
					refreshScrollMetrics();
					ScrollTrigger.refresh();
					lenis?.resize();
				});
			}
			document.addEventListener('click', onTextSizeChange);

			document.querySelector('[data-beach-dream-journal]')?.addEventListener('click', () => {
				window.location.href = '/dream-journal';
			});

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			let lenis: Lenis | null = null;
			let lenisTick: ((t: number) => void) | null = null;

			const stopScrollOrchestrator = initScrollOrchestrator();

			if (!reduceMotion) {
				lenis = new Lenis({
					duration: 1.15,
					/* Long, flat-tailed ease — glides to rest instead of stopping dead. */
					easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					smoothWheel: true,
					touchMultiplier: 1.35,
				});

				ScrollTrigger.scrollerProxy(document.body, {
					scrollTop(value) {
						if (arguments.length && typeof value === 'number' && lenis) {
							lenis.scrollTo(value, { immediate: true });
						}
						return lenis ? lenis.scroll : 0;
					},
					getBoundingClientRect() {
						return {
							top: 0,
							left: 0,
							width: window.innerWidth,
							height: window.innerHeight,
						};
					},
				});

				/* Lenis is the visual scroll position, so it drives every subscriber. */
				lenis.on('scroll', (e: { scroll: number }) => {
					publishScroll(e.scroll);
					ScrollTrigger.update();
				});

				lenisTick = (time: number) => {
					if (lenis) lenis.raf(time * 1000);
				};
				gsap.ticker.add(lenisTick);
				gsap.ticker.lagSmoothing(0);
			}

			let stopReveal = initPageRevealAnimations();

			const path = window.location.pathname.replace(/\/$/, '') || '/';
			let stopHome = () => {};
			if (path === '' || path === '/') {
				stopHome = initHomeHero();
			}

			/* Reveal/GSAP may have just zeroed the Beach hero copy — re-sync layout
			 * and scroll metrics so planets + Beach text are visible without a refresh. */
			syncHeroLayout(getStoredTheme());
			refreshScrollMetrics();
			requestAnimationFrame(() => {
				refreshScrollMetrics();
				ScrollTrigger.refresh();
				window.dispatchEvent(
					new CustomEvent('aditi:theme-layout', { detail: { theme: getStoredTheme() } }),
				);
			});

			/*
			 * Compact state is a single attribute flipped only when it changes. All the
			 * visual work lives in CSS, so scrolling never writes inline styles or
			 * animates padding.
			 */
			const header = document.querySelector('[data-site-header]') as HTMLElement | null;

			/* Hero height is viewport minus header; the header wraps at narrow widths. */
			let headerResize: ResizeObserver | null = null;
			if (header) {
				const syncHeaderHeight = () => {
					html.style.setProperty('--site-header-h', `${header.offsetHeight}px`);
				};
				syncHeaderHeight();
				headerResize = new ResizeObserver(() => {
					syncHeaderHeight();
					refreshScrollMetrics();
				});
				headerResize.observe(header);
			}

			let headerCompact = false;
			const unsubscribeHeader = subscribeScroll(({ y }) => {
				if (!header) return;
				const next = y > 24;
				if (next === headerCompact) return;
				headerCompact = next;
				header.toggleAttribute('data-scrolled', next);
			});

			function onResizeNav() {
				syncCoarsePointerAttribute();
				syncSiteNavChrome();
			}
			window.addEventListener('resize', onResizeNav);

			if (import.meta.hot) {
				import.meta.hot.dispose(() => {
					stopReveal();
					stopHome();
					stopTextSizeControl();
					unsubscribeHeader();
					headerResize?.disconnect();
					stopScrollOrchestrator();
					document.removeEventListener('click', onThemeToggleClick);
					document.removeEventListener('click', onTextSizeChange);
					window.removeEventListener('resize', onResizeNav);
					if (lenisTick) gsap.ticker.remove(lenisTick);
					if (lenis) lenis.destroy();
					ScrollTrigger.getAll().forEach((t) => t.kill());
				});
			}
		</script>
	</body>
</html>
