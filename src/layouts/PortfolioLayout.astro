---
/**
 * Portfolio theme shell (lab). Deliberately separate from Layout.astro: no
 * starfield, beach video, splash or theme script, so Orbit and Flow are not
 * touched. noindex while the direction is being chosen.
 */
import '../styles/portfolio.css';
import { FONTSHARE_CSS, STAND_IN_CSS, defaultTypePair, typePairs } from '../data/portfolio-type.ts';

interface Props {
	title: string;
	variant?: 'a' | 'b';
}

const { title, variant } = Astro.props;
const pairIds = typePairs.map((p) => p.id);
---

<!doctype html>
<html lang="en" data-pf-variant={variant} data-type={defaultTypePair}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#fffdfa" />
		<title>{title}</title>
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/logo-universe-32.png" />
		<script is:inline define:vars={{ pairIds }}>
			try {
				var q = new URLSearchParams(location.search);
				var t = q.get('type') || localStorage.getItem('pf-type');
				if (pairIds.indexOf(t) >= 0) document.documentElement.dataset.type = t;
				if (q.get('embed') === '1') document.documentElement.dataset.embed = '';
			} catch (e) {}
		</script>
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTSHARE_CSS} />
		<link rel="stylesheet" href={STAND_IN_CSS} />
	</head>
	<body>
		<slot />
	</body>
</html>
