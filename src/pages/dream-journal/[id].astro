---
/**
 * Legacy /dream-journal/:id URLs redirect to the shell with ?id=
 * (entry HTML still comes from the authenticated API).
 */
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	const entries = await getCollection('dreams', ({ data }) => data.draft !== true);
	return entries.map((entry) => ({ params: { id: entry.id } }));
}

const id = Astro.params.id ?? '';
return Astro.redirect(`/dream-journal?id=${encodeURIComponent(id)}`, 302);
---
