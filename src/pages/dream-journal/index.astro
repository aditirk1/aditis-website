---
/**
 * Dream Journal shell — list/detail HTML is loaded from /api/dreams after OAuth.
 * No dream Markdown is embedded in this page at build time.
 */
import Layout from '../../layouts/Layout.astro';
import DreamJournalGate from '../../components/DreamJournalGate.astro';
---

<Layout layoutVariant="dream" title="Dream Journal · aditi's universe" noindex={true}>
	<DreamJournalGate>
		<div class="pointer-events-auto mx-auto max-w-2xl pb-16" data-dream-entrance>
			<p class="mb-8 flex flex-wrap items-center justify-between gap-3">
				<a href="/" class="article-back-link">← Back to the universe</a>
				<button
					type="button"
					data-dream-sign-out
					class="text-sm text-[var(--page-muted)] underline-offset-2 hover:text-[var(--color-amber)] hover:underline"
				>
					Sign out
				</button>
			</p>
			<h1 class="mb-2 text-4xl font-light md:text-5xl" style="font-family: var(--font-display)">
				Dream Journal
			</h1>
			<p class="mb-6 max-w-prose text-lg text-[var(--page-muted)]">
				Ethereal, a little surreal — hover the emphasized words on each entry if you like.
			</p>
			<p data-dream-status class="mb-6 text-sm text-[var(--page-muted)]"></p>
			<div class="flex flex-col gap-6" data-dream-list></div>
			<div data-dream-detail hidden></div>
		</div>
	</DreamJournalGate>
</Layout>
<script>
	import { gsap } from 'gsap';

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const entrance = document.querySelector('[data-dream-entrance]') as HTMLElement | null;

	if (!reduce && entrance) {
		gsap.fromTo(
			entrance,
			{ opacity: 0, filter: 'blur(12px)', y: 12 },
			{ opacity: 1, filter: 'blur(0px)', y: 0, duration: 1.25, ease: 'power2.out', delay: 0.08 },
		);
	}
</script>
