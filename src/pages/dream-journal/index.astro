---
/**
 * Dream Journal — ethereal layout variant, comic-style word hits, GSAP hover on hits.
 * Entries: src/content/dreams/*.md (see frontmatter highlight-words + word-styles).
 */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { stripFrontmatter, dreamMarkdownToHtml } from '../../utils/dream-markdown.ts';

const entries = await getCollection('dreams', ({ data }) => data.draft !== true);
const sorted = entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
	sorted.map(async (entry) => {
		const fp = path.join(process.cwd(), 'src', 'content', 'dreams', `${entry.id}.md`);
		const rawFile = fs.readFileSync(fp, 'utf8');
		const md = stripFrontmatter(rawFile);
		const html = await dreamMarkdownToHtml(
			md,
			entry.data['highlight-words'],
			entry.data['word-styles'],
		);
		return { entry, html };
	}),
);
---

<Layout layoutVariant="dream" title="Dream Journal · aditi's universe">
	<div class="pointer-events-auto mx-auto max-w-2xl pb-16" data-dream-entrance>
		<h1 class="mb-2 text-4xl font-light md:text-5xl" style="font-family: var(--font-display)">Dream Journal</h1>
		<p class="mb-10 max-w-prose text-lg text-[var(--page-muted)]">
			Ethereal, a little surreal — comic-book emphasis on chosen words (hover them). Soundtrack switches automatically
			here if you add audio files under <code class="text-[var(--color-amber)]">/public/audio/</code>.
		</p>

		{
			rendered.length === 0 ? (
				<p class="text-[var(--page-muted)]">No dreams published yet. Add Markdown to <code>src/content/dreams/</code>.</p>
			) : (
				rendered.map(({ entry, html }) => (
					<article class="dream-realm-panel relative mb-10 px-6 py-8 md:px-8 md:py-10">
						<div class="dream-realm-article">
							<p class="dream-entry-meta mb-5">
								{entry.data.date.toLocaleDateString(undefined, {
									weekday: 'long',
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})}
								{entry.data.mood && <> · {entry.data.mood}</>}
							</p>
							<div
								class="dream-md space-y-4 text-lg leading-relaxed text-[var(--page-fg)] [&_p]:mb-4"
								set:html={html}
							/>
						</div>
					</article>
				))
			)
		}
	</div>
</Layout>

<script>
	import { gsap } from 'gsap';

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const entrance = document.querySelector('[data-dream-entrance]') as HTMLElement | null;

	if (!reduce && entrance) {
		gsap.fromTo(
			entrance,
			{ opacity: 0, filter: 'blur(12px)', y: 12 },
			{ opacity: 1, filter: 'blur(0px)', y: 0, duration: 1.25, ease: 'power2.out', delay: 0.08 },
		);
	}

	if (!reduce) {
		document.querySelectorAll('.dream-hit').forEach((el) => {
			el.addEventListener('mouseenter', () => {
				gsap.to(el, { scale: 1.08, duration: 0.22, ease: 'power2.out' });
			});
			el.addEventListener('mouseleave', () => {
				gsap.to(el, { scale: 1, duration: 0.35, ease: 'power3.inOut' });
			});
		});
	}
</script>
