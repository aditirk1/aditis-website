---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { readingTimeMinutes, excerptLines } from '../../utils/content-helpers.ts';

const posts = await getCollection('blog', ({ data }) => data.draft !== true);
const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const enriched = sorted.map((post) => {
	const fp = path.join(process.cwd(), 'src', 'content', 'blog', `${post.id}.md`);
	let raw = '';
	try {
		raw = fs.readFileSync(fp, 'utf8');
	} catch {
		raw = '';
	}
	return {
		post,
		minutes: readingTimeMinutes(raw),
		excerpt: excerptLines(raw, 2) || '…',
	};
});
---

<Layout title="Blog · aditi's universe">
	<div class="pointer-events-auto mx-auto max-w-2xl">
		<div data-reveal-stagger class="mb-8">
			<h1 class="text-4xl font-light" style="font-family: var(--font-display)" data-reveal-child>Blog</h1>
		</div>
		<ul class="flex flex-col gap-5">
			{
				enriched.map(({ post, minutes, excerpt }) => (
					<li class="overflow-hidden rounded-2xl" data-blog-wipe>
						<div data-blog-wipe-inner>
							<a href={`/blog/${post.id}`} class="group block">
								<div class="card-3d-pop prose-shell px-5 py-5">
									<h2 class="text-xl font-light text-[var(--page-fg)] group-hover:text-[var(--color-amber)]">
										{post.data.title}
									</h2>
									<p class="mt-1 text-sm text-[var(--page-muted)]">
										{post.data.date.toLocaleDateString()} · {minutes} min read
									</p>
									<p class="mt-3 line-clamp-2 text-sm leading-relaxed text-[var(--page-muted)]">{excerpt}</p>
								</div>
							</a>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
