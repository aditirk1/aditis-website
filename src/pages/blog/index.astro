---
import Layout from '../../layouts/Layout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { loadBlogPosts, groupByCategory, hasNamedCategories, type BlogPost } from '../../utils/blog.ts';

const posts = await loadBlogPosts();
const categories = groupByCategory(posts);
const showCategories = hasNamedCategories(categories);
---

<Layout title="Blog · aditi's universe">
	<div class="page-list-shell page-list-shell--blog">
		<div data-reveal-stagger class="page-list-header">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Blog
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
			{showCategories && (
				<nav aria-label="Blog categories" class="mt-6 flex flex-wrap gap-2" data-reveal-child>
					{categories.map((category) => (
						<a
							href={`#${category.id || 'other'}`}
							class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_18%,transparent)] px-4 py-1.5 text-sm text-[var(--page-muted)] transition hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
						>
							{category.label}
							<span class="ml-1.5 opacity-60">{category.posts.length}</span>
						</a>
					))}
				</nav>
			)}
		</div>

		{posts.length === 0 ? (
			<EmptyState
				message="Nothing to see here yet — more to come very soon."
				hint="The cursor is blinking somewhere. Essays will land here when they're ready."
			/>
		) : (
			categories.map((category) => (
				<section id={category.id || 'other'} class="scroll-mt-28 [&+&]:mt-14">
					{showCategories && (
						<h2
							class="mb-2 text-sm font-semibold uppercase tracking-[0.2em] text-[var(--color-amber)]"
							data-reveal-child
						>
							{category.label}
						</h2>
					)}
					<div
						class="flex flex-col gap-0 divide-y divide-[color-mix(in_srgb,var(--page-fg)_10%,transparent)]"
						data-reveal-stagger
					>
						{category.posts.map((post: BlogPost) => (
							<a
								href={post.href}
								class="blog-list-card group block py-8 transition-colors first:pt-0"
								data-reveal-child
							>
								<div class="flex items-baseline justify-between gap-4">
									<h3
										class="text-2xl font-semibold text-[var(--page-fg)] transition-colors group-hover:text-[var(--color-amber)] md:text-[1.75rem]"
										style="font-family: var(--font-display)"
									>
										{post.entry.data.title}
									</h3>
									<span class="shrink-0 text-sm tracking-wide text-[var(--page-muted)]">
										{post.minutes} min
									</span>
								</div>
								<p class="mt-1 text-sm uppercase tracking-wider text-[var(--page-muted)]">
									{post.entry.data.date.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</p>
								<p class="mt-3 line-clamp-2 text-lg leading-relaxed text-[var(--page-muted)] transition-colors group-hover:text-[var(--page-fg)]">
									{post.excerpt}
								</p>
							</a>
						))}
					</div>
				</section>
			))
		)}
	</div>
</Layout>
