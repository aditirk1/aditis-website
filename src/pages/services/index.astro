---
import Layout from '../../layouts/Layout.astro';
import ContactModal from '../../components/ContactModal.astro';
import page from '../../data/services.json';

const stripeCheckoutEnabled = import.meta.env.PUBLIC_STRIPE_CHECKOUT === 'true';
const checkoutCanceled = Astro.url.searchParams.get('checkout') === 'canceled';
const contactEnabled = Boolean(import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim());

const { services, process } = page;
const ctaBody = stripeCheckoutEnabled
	? page.cta_body_stripe
	: contactEnabled
		? page.cta_body_contact
		: page.cta_body_linkedin;
---

<Layout title={`${page.page_title} · aditi's universe`}>
	<div class="page-list-shell">
		<div data-reveal-stagger class="page-list-header">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				{page.page_title}
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
			<p class="mt-4 max-w-3xl text-xl leading-relaxed text-[var(--page-muted)]" data-reveal-child>
				{page.intro}
			</p>
			{
				checkoutCanceled && (
					<p
						class="mt-4 rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_18%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_80%,transparent)] px-4 py-3 text-base text-[var(--page-muted)]"
						data-reveal-child
					>
						Checkout was canceled — no charge. You can try again or reach out below.
					</p>
				)
			}
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6 lg:gap-10" data-reveal-stagger>
			{
				services.map((s) => (
					<article class="flex flex-col" data-reveal-child>
						<h2 class="text-2xl font-semibold tracking-tight md:text-[1.65rem]" style="font-family: var(--font-display)">
							{s.title}
						</h2>
						<p class="mt-3 text-lg leading-relaxed text-[var(--page-muted)]">{s.teaser}</p>
						<p class="mt-4 text-base leading-relaxed text-[var(--page-fg)]">{s.detail}</p>
						<ul class="mt-4 list-inside list-disc space-y-2 text-base leading-relaxed text-[var(--page-muted)]">
							{s.includes.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<section class="mt-16" data-reveal-stagger>
			<h2
				class="text-2xl font-semibold tracking-tight md:text-[1.75rem]"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				{page.process_heading}
			</h2>
			<ol class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6 lg:gap-10">
				{
					process.map(({ step, title, body }) => (
						<li class="flex flex-col gap-3" data-reveal-child>
							<span
								class="font-mono text-sm tracking-widest text-[var(--color-amber)]"
								aria-hidden="true"
							>
								{step}
							</span>
							<div>
								<h3 class="text-lg font-semibold text-[var(--page-fg)]">{title}</h3>
								<p class="mt-2 text-base leading-relaxed text-[var(--page-muted)]">{body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section
			class="mt-16 rounded-2xl border border-[color-mix(in_srgb,var(--color-amber)_28%,transparent)] bg-[color-mix(in_srgb,var(--color-amber)_6%,transparent)] p-6 md:p-10"
			data-reveal-stagger
		>
			<h2
				class="text-2xl font-semibold tracking-tight"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				{page.cta_heading}
			</h2>
			<p class="mt-3 max-w-3xl text-base leading-relaxed text-[var(--page-muted)]" data-reveal-child>
				{ctaBody}
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-reveal-child>
				{
					contactEnabled && (
						<button
							type="button"
							class="rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_10%,transparent)] px-7 py-3.5 text-base font-bold text-[var(--color-amber)] transition fine-hover:scale-[1.03] fine-hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)]"
							data-contact-open
						>
							Work with me
						</button>
					)
				}
				<a
					href="https://www.linkedin.com/in/aditirk/"
					target="_blank"
					rel="noopener noreferrer"
					class={
						contactEnabled
							? 'rounded-full border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] px-7 py-3.5 text-center text-base font-bold text-[var(--page-fg)] transition fine-hover:border-[var(--color-amber)] fine-hover:text-[var(--color-amber)]'
							: 'rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_10%,transparent)] px-7 py-3.5 text-center text-base font-bold text-[var(--color-amber)] transition fine-hover:scale-[1.03] fine-hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)]'
					}
				>
					Message on LinkedIn
				</a>
				{
					stripeCheckoutEnabled && (
						<button
							type="button"
							class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_60%,transparent)] px-7 py-3.5 text-base font-bold text-[var(--page-fg)] transition fine-hover:border-[var(--color-amber)] fine-hover:text-[var(--color-amber)]"
							data-stripe-checkout
						>
							Pay securely (Stripe)
						</button>
					)
				}
			</div>
			{
				stripeCheckoutEnabled && (
					<p class="mt-3 text-sm text-[var(--page-muted)]" data-reveal-child>
						Secure hosted checkout — cards and wallets where Stripe enables them.
					</p>
				)
			}
		</section>
	</div>

	<ContactModal />

	{
		stripeCheckoutEnabled && (
			<script>
				const btn = document.querySelector('[data-stripe-checkout]') as HTMLButtonElement | null;
				btn?.addEventListener('click', async () => {
					if (!btn) return;
					const prev = btn.textContent;
					btn.disabled = true;
					btn.textContent = 'Redirecting…';
					try {
						const r = await fetch('/api/checkout', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: '{}',
							credentials: 'same-origin',
						});
						const d = (await r.json()) as { ok?: boolean; url?: string; error?: string };
						if (d.url) {
							window.location.href = d.url;
							return;
						}
						alert(d.error ?? 'Could not start checkout.');
					} catch {
						alert('Network error — try again or use the contact form.');
					} finally {
						btn.disabled = false;
						btn.textContent = prev ?? 'Pay securely (Stripe)';
					}
				});
			</script>
		)
	}
</Layout>
