---
import Layout from '../../layouts/Layout.astro';
import ContactModal from '../../components/ContactModal.astro';

const stripeCheckoutEnabled = import.meta.env.PUBLIC_STRIPE_CHECKOUT === 'true';
const checkoutCanceled = Astro.url.searchParams.get('checkout') === 'canceled';

const services = [
	{
		title: 'Research consulting',
		teaser: 'Literature synthesis, experiment design, signal & systems thinking.',
		detail:
			'Scoped engagements from a single deep-dive memo to multi-week support. Pricing depends on scope — we align after a short intro call.',
	},
	{
		title: 'Technical writing',
		teaser: 'Grants, reports, and explainers that stay precise without going cold.',
		detail: 'Per document or monthly retainer. Clear milestones and revision rounds baked in.',
	},
	{
		title: 'Design + prototyping',
		teaser: 'Interfaces, diagrams, and small interactive proofs-of-concept.',
		detail: 'Figma plus light front-end when it helps the story land. Milestone-based delivery.',
	},
] as const;
---

<Layout title="Services · aditi's universe">
	<div class="pointer-events-auto mx-auto max-w-3xl px-2">
		<div data-reveal-stagger class="mb-12">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Services
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
			<p class="mt-4 text-lg text-[var(--page-muted)]" data-reveal-child>
				Research, writing, and design support for teams that care about clarity. Tell me what you are building — we
				can shape a scope together.
			</p>
			{
				checkoutCanceled && (
					<p
						class="mt-4 rounded-lg border border-[color-mix(in_srgb,var(--page-fg)_18%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_80%,transparent)] px-4 py-3 text-sm text-[var(--page-muted)]"
						data-reveal-child
					>
						Checkout was canceled — no charge. You can try again or reach out below.
					</p>
				)
			}
		</div>

		<div
			class="flex flex-col gap-0 divide-y divide-[color-mix(in_srgb,var(--page-fg)_10%,transparent)]"
			data-reveal-stagger
		>
			{
				services.map((s) => (
					<div class="group cursor-default py-8 first:pt-0" data-reveal-child>
						<div class="flex flex-wrap items-start justify-between gap-4">
							<h2 class="text-2xl font-semibold tracking-tight" style="font-family: var(--font-display)">
								{s.title}
							</h2>
						</div>
						<p class="mt-2 text-base leading-relaxed text-[var(--page-muted)]">{s.teaser}</p>
						<div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-hover:grid-rows-[1fr]">
							<div class="min-h-0 overflow-hidden">
								<p class="pb-1 pt-4 text-sm leading-relaxed text-[var(--page-fg)]">{s.detail}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>

		<div class="mt-12 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center" data-reveal-stagger>
			<button
				type="button"
				class="rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_10%,transparent)] px-7 py-3.5 text-sm font-bold text-[var(--color-amber)] transition hover:scale-[1.03] hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)]"
				data-contact-open
				data-reveal-child
			>
				Work with me
			</button>
			{
				stripeCheckoutEnabled && (
					<button
						type="button"
						class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_22%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_60%,transparent)] px-7 py-3.5 text-sm font-bold text-[var(--page-fg)] transition hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
						data-stripe-checkout
						data-reveal-child
					>
						Pay securely (Stripe)
					</button>
				)
			}
		</div>
		{
			stripeCheckoutEnabled && (
				<p class="mt-3 text-xs text-[var(--page-muted)]" data-reveal-child>
					Secure hosted checkout — cards and wallets where Stripe enables them.
				</p>
			)
		}
	</div>

	<ContactModal />

	{
		stripeCheckoutEnabled && (
			<script>
				const btn = document.querySelector('[data-stripe-checkout]') as HTMLButtonElement | null;
				btn?.addEventListener('click', async () => {
					if (!btn) return;
					const prev = btn.textContent;
					btn.disabled = true;
					btn.textContent = 'Redirecting…';
					try {
						const r = await fetch('/api/checkout', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: '{}',
							credentials: 'same-origin',
						});
						const d = (await r.json()) as { ok?: boolean; url?: string; error?: string };
						if (d.url) {
							window.location.href = d.url;
							return;
						}
						alert(d.error ?? 'Could not start checkout.');
					} catch {
						alert('Network error — try again or use the contact form.');
					} finally {
						btn.disabled = false;
						btn.textContent = prev ?? 'Pay securely (Stripe)';
					}
				});
			</script>
		)
	}
</Layout>
