---
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import ContentLightbox from '../../components/ContentLightbox.astro';
import EmptyState from '../../components/EmptyState.astro';
import { albumPhotoSources, loadPhotoAlbums } from '../../utils/photo-dump.ts';

const photosRoot = path.join(process.cwd(), 'public', 'photos');
const albums = loadPhotoAlbums(photosRoot);
const hasPhotos = albums.some((a) => a.photos.length > 0);
---

<Layout title="Photo dump · aditi's universe">
	<div class="page-list-shell">
		<div data-reveal-stagger class="page-list-header">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Photo dump
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
			<p class="mt-4 max-w-xl text-sm leading-relaxed text-[var(--page-muted)]" data-reveal-child>
				Snapshots from life and work — click any image to open it larger.
			</p>
		</div>

		{
			!hasPhotos ? (
				<EmptyState
					message="Nothing to see here yet — more to come very soon."
					hint="The camera roll is a disaster and curation takes time. Albums are on the way."
				/>
			) : (
				<div class="flex flex-col gap-16">
					{albums.map((album) => {
						const sources = albumPhotoSources(album);
						return (
							<section data-reveal-stagger data-lightbox-gallery={JSON.stringify(sources)}>
								<h2
									class="mb-6 text-2xl font-semibold tracking-tight"
									style="font-family: var(--font-display)"
									data-reveal-child
								>
									{album.label}
								</h2>
								<ul class="columns-2 gap-4 sm:columns-3 md:columns-4">
									{album.photos.map((photo, i) => (
										<li class="mb-4 break-inside-avoid" data-reveal-child>
											<button
												type="button"
												class="photo-dump-btn group w-full overflow-hidden rounded-xl border-0 bg-transparent p-0 text-left shadow-md transition-shadow hover:shadow-[0_0_20px_color-mix(in_srgb,var(--color-amber)_20%,transparent)]"
												data-lightbox-open={i}
												data-lightbox-caption={photo.name}
											>
												<img
													src={photo.src}
													alt={photo.name}
													class="photo-thumb h-auto w-full object-cover transition group-hover:brightness-110"
													loading="lazy"
													decoding="async"
													data-photo-img
												/>
											</button>
										</li>
									))}
								</ul>
							</section>
						);
					})}
				</div>
			)
		}
	</div>

	<ContentLightbox />
</Layout>

<script>
	import { createMediaLightbox, initGalleryLightboxButtons } from '../../scripts/media-lightbox.ts';

	const lightbox = createMediaLightbox();
	const stopButtons = lightbox ? initGalleryLightboxButtons(lightbox) : () => {};

	document.querySelectorAll('[data-photo-img]').forEach((img) => {
		if ((img as HTMLImageElement).complete) img.classList.add('is-loaded');
		else img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
	});

	if (import.meta.hot) {
		import.meta.hot.dispose(() => {
			stopButtons();
			lightbox?.close();
		});
	}
</script>
