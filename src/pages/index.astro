---
import Layout from '../layouts/Layout.astro';
import SplashIntro from '../components/SplashIntro.astro';
import LiveVisitorMap from '../components/LiveVisitorMap.astro';
import home from '../data/home.json';

const heroTitle = home.hero_title;
/* Grouped by word so per-letter spans can't be broken mid-word by wrapping. */
const heroWords = heroTitle.split(' ').map((word) => word.split(''));
/* The displayed title ends in a full stop; the browser tab reads better without it. */
const documentTitle = `${heroTitle.replace(/\.$/, '')} · aditirk.me`;
const exploreCards = home.explore_cards;
const taglines = Array.isArray(home.taglines) ? home.taglines.filter(Boolean) : [];
const firstTagline = taglines[0] ?? '';
---

<Layout title={documentTitle}>
	<SplashIntro />

	<!-- Hero: pointer-events-none so the starfield canvas can receive clicks (secret star). Interactive bits opt in. -->
	<section class="home-hero pointer-events-none relative" data-hero-root>
		<div class="home-hero-grid">
			<div class="home-hero-title-col">
				<div id="sun-wrapper">
					<h1 id="sun-text" data-hero-title>
						{heroWords.map((chars, i) => (
							<span class="hero-word">
								{chars.map((ch) => (
									<span class="hero-char">{ch}</span>
								))}
							</span>
						))}
					</h1>
				</div>
			</div>
			<!--
				RIGHT zone. Universe: the orrery renders here (WebGL, behind) and this
				box is what it centres on; the caption is placed against its bottom edge.
				Beach: the copy block is moved in by syncHeroLayout().
			-->
			<div class="home-hero-side-col" data-hero-side-slot>
				<div id="planet-label">
					<span id="planet-label-text">{home.planet_label}</span>
				</div>
			</div>
		</div>

		<div class="hero-scroll-cue" aria-hidden="true">
			<span class="inline-block text-3xl text-[var(--color-amber)] will-change-transform" data-hero-chevron>⌄</span>
		</div>
	</section>

	<!--
		Copy block: Beach only (right column via syncHeroLayout).
		Universe hides this entire band — hero is title + planets only.
	-->
	<section class="home-intro pointer-events-none relative" data-hero-intro-home hidden>
		<div class="home-intro-inner" data-hero-copy data-reveal-stagger>
			<p
				class="home-hero-extra text-xl font-medium tracking-wide text-[var(--color-amber)] md:text-2xl"
				style="font-family: var(--font-display)"
				data-hero-tagline
				data-tagline-items={JSON.stringify(taglines)}
				data-reveal-child
			>
				{firstTagline}
			</p>
			<p
				class="home-hero-extra home-hero-desc mt-6 text-pretty text-lg leading-relaxed text-[var(--page-muted)] md:text-xl"
				data-reveal-child
			>
				{home.hero_description}
			</p>
			<div class="home-hero-extra pointer-events-auto mt-10 flex flex-wrap gap-4" data-reveal-child>
				<a
					href={home.cta_primary_href}
					class="rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_10%,transparent)] px-6 py-3 text-sm font-bold text-[var(--page-fg)] backdrop-blur-sm transition fine-hover:scale-105 fine-hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)] fine-hover:shadow-[0_0_28px_color-mix(in_srgb,var(--color-amber)_30%,transparent)]"
				>
					{home.cta_primary_label}
				</a>
				<a
					href={home.cta_secondary_href}
					class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_25%,transparent)] px-6 py-3 text-sm font-bold text-[var(--page-fg)] backdrop-blur-sm transition fine-hover:border-[var(--color-amber)] fine-hover:text-[var(--color-amber)]"
				>
					{home.cta_secondary_label}
				</a>
			</div>
		</div>
	</section>

	<section
		class="pointer-events-auto relative mx-auto max-w-5xl px-8 py-20 md:px-16 md:py-28"
		data-reveal-stagger
	>
		<h2
			class="text-3xl font-semibold tracking-tight md:text-4xl"
			style="font-family: var(--font-display)"
			data-reveal-child
		>
			{home.about_heading}
		</h2>
		<div class="mt-1 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		{
			home.about_paragraphs.map((paragraph, i) => (
				<p
					class:list={[
						'text-lg leading-relaxed text-[var(--page-muted)]',
						i === 0 ? 'mt-6' : 'mt-4',
					]}
					data-reveal-child
				>
					{paragraph}
				</p>
			))
		}
		<p class="mt-6" data-reveal-child>
			<a
				href={home.resume_href}
				class="text-sm font-semibold text-[var(--color-amber)] underline underline-offset-4 hover:opacity-90"
			>
				{home.resume_label}
			</a>
		</p>
	</section>

	<section
		class="home-explore pointer-events-auto relative mx-auto max-w-5xl px-8 py-12 md:px-16 md:py-20"
		data-reveal-stagger
	>
		<h2
			class="text-3xl font-semibold tracking-tight md:text-4xl"
			style="font-family: var(--font-display)"
			data-reveal-child
		>
			{home.explore_heading}
		</h2>
		<div class="mt-1 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{exploreCards.map(({ href, title, desc }) => (
				<a
					href={href}
					class="home-explore-card group relative overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--page-fg)_12%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_70%,transparent)] p-6 backdrop-blur-md transition-all duration-300 fine-hover:border-[var(--color-amber)] fine-hover:shadow-[0_0_32px_color-mix(in_srgb,var(--color-amber)_15%,transparent)]"
					data-reveal-child
				>
					<h3 class="text-lg font-semibold" style="font-family: var(--font-display)">
						{title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-[var(--page-muted)] transition-colors fine-group-hover:text-[var(--page-fg)]">
						{desc}
					</p>
					<span class="explore-card-cta mt-3 inline-block text-xs font-bold tracking-wide text-[var(--color-amber)] opacity-0 transition-opacity fine-group-hover:opacity-100 group-focus-within:opacity-100">
						Explore →
					</span>
				</a>
			))}
		</div>
	</section>

	<section class="pointer-events-auto relative mx-auto max-w-3xl px-8 py-12 md:px-16 md:py-20" data-reveal-stagger>
		<div data-reveal-child>
			<LiveVisitorMap />
		</div>
	</section>
</Layout>
