---
import Layout from '../layouts/Layout.astro';
import SplashIntro from '../components/SplashIntro.astro';
import LiveVisitorMap from '../components/LiveVisitorMap.astro';

const heroTitle = "aditi's universe";
const heroChars = heroTitle.split('');

const exploreCards = [
	{ href: '/projects', title: 'Projects', desc: 'Research, engineering, and creative builds.' },
	{ href: '/blog', title: 'Blog', desc: 'Long-form essays and technical explorations.' },
	{ href: '/thoughts', title: 'Thoughts', desc: 'Shorter notes, observations, and fragments.' },
	{ href: '/photo-dump', title: 'Photo Dump', desc: 'Visual snapshots from life and work.' },
	{ href: '/services', title: 'Services', desc: 'Research consulting, writing, and design.' },
];
---

<Layout title="aditi's universe · aditirk.me">
	<SplashIntro />

	<!-- Hero: pointer-events-none so the starfield canvas can receive clicks (secret star). Interactive bits opt in. -->
	<section
		class="pointer-events-none relative flex min-h-[100dvh] flex-col items-start justify-center px-5 pb-20 pt-6 sm:px-8 md:px-16 md:pb-24 md:pt-8 lg:px-24"
		data-hero-root
		data-reveal-stagger
	>
		<div id="sun-wrapper">
			<h1 id="sun-text" data-hero-title>
				{heroChars.map((ch) => (
					<span class="hero-char">{ch === ' ' ? '\u00a0' : ch}</span>
				))}
			</h1>
			<span class="sparkle" style="--sx: -60px; --sy: -12px; --sd: 0s" aria-hidden="true"></span>
			<span class="sparkle" style="--sx: 62px; --sy: -8px; --sd: 0.4s" aria-hidden="true"></span>
			<span class="sparkle" style="--sx: -40px; --sy: 14px; --sd: 0.8s" aria-hidden="true"></span>
			<span class="sparkle" style="--sx: 50px; --sy: 10px; --sd: 1.2s" aria-hidden="true"></span>
			<span class="sparkle" style="--sx: 10px; --sy: -18px; --sd: 1.6s" aria-hidden="true"></span>
			<span class="sparkle" style="--sx: -20px; --sy: 16px; --sd: 2.1s" aria-hidden="true"></span>
		</div>
		<div id="planet-label">
			<span id="planet-label-text">tap a planet to explore</span>
		</div>
		<p
			class="home-hero-extra mt-4 text-xl font-medium tracking-wide text-[var(--color-amber)] md:mt-6 md:text-2xl"
			style="font-family: var(--font-display)"
			data-hero-tagline
		>
			biomedical engineer · health analytics · robotics
		</p>
		<p
			class="home-hero-extra home-hero-desc mt-6 text-pretty text-lg leading-relaxed text-[var(--page-muted)] md:text-xl"
			data-reveal-child
		>
			MS Bioengineering at Columbia. I work across genomics pipelines, Medicare-scale outcomes research,
			EEG/brain–computer interfaces, and hardware — the full arc from model to bench to population data.
		</p>
		<div class="home-hero-extra pointer-events-auto mt-10 flex flex-wrap gap-4" data-reveal-child>
			<a
				href="/projects"
				class="rounded-full border border-[var(--color-amber)] bg-[color-mix(in_srgb,var(--color-amber)_10%,transparent)] px-6 py-3 text-sm font-bold text-[var(--page-fg)] backdrop-blur-sm transition hover:scale-105 hover:bg-[color-mix(in_srgb,var(--color-amber)_22%,transparent)] hover:shadow-[0_0_28px_color-mix(in_srgb,var(--color-amber)_30%,transparent)]"
			>
				See my work
			</a>
			<a
				href="/services"
				class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_25%,transparent)] px-6 py-3 text-sm font-bold text-[var(--page-fg)] backdrop-blur-sm transition hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
			>
				Let's talk
			</a>
		</div>

		<div class="pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2" aria-hidden="true">
			<span class="inline-block text-3xl text-[var(--color-amber)] will-change-transform" data-hero-chevron>⌄</span>
		</div>
	</section>

	<section
		class="pointer-events-auto relative mx-auto max-w-3xl px-8 py-20 md:px-16 md:py-28"
		data-reveal-stagger
	>
		<h2
			class="text-3xl font-semibold tracking-tight md:text-4xl"
			style="font-family: var(--font-display)"
			data-reveal-child
		>
			About me
		</h2>
		<div class="mt-1 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		<p class="mt-6 text-lg leading-relaxed text-[var(--page-muted)]" data-reveal-child>
			I'm a biomedical engineering graduate student at Columbia. My background spans automated genomic
			pipelines and molecular dynamics, large-scale CMS Medicare analysis, EEG signal processing, and
			building things that move — quadruped robots, nanobot navigation concepts, and the occasional walking
			pipeline debug at 2&nbsp;a.m.
		</p>
		<p class="mt-4 text-lg leading-relaxed text-[var(--page-muted)]" data-reveal-child>
			Outside the lab I'm a lead at <strong class="font-medium text-[var(--page-fg)]">Nucleate New York</strong>
			and care about the gap between a promising innovation and one that actually reaches patients. This site
			is projects, writing, and the occasional dream journal — navigate with the tabs, the planets, or scroll.
		</p>
		<p class="mt-6" data-reveal-child>
			<a
				href="/resume.pdf"
				class="text-sm font-semibold text-[var(--color-amber)] underline underline-offset-4 hover:opacity-90"
			>
				Download résumé (PDF)
			</a>
		</p>
	</section>

	<section
		class="home-explore pointer-events-auto relative mx-auto max-w-5xl px-8 py-12 md:px-16 md:py-20"
		data-reveal-stagger
	>
		<h2
			class="text-3xl font-semibold tracking-tight md:text-4xl"
			style="font-family: var(--font-display)"
			data-reveal-child
		>
			Explore
		</h2>
		<div class="mt-1 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		<div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{exploreCards.map(({ href, title, desc }) => (
				<a
					href={href}
					class="group relative overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--page-fg)_12%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_70%,transparent)] p-6 backdrop-blur-md transition-all duration-300 hover:border-[var(--color-amber)] hover:shadow-[0_0_32px_color-mix(in_srgb,var(--color-amber)_15%,transparent)]"
					data-reveal-child
				>
					<h3 class="text-lg font-semibold" style="font-family: var(--font-display)">
						{title}
					</h3>
					<p class="mt-2 text-sm leading-relaxed text-[var(--page-muted)] transition-colors group-hover:text-[var(--page-fg)]">
						{desc}
					</p>
					<span class="explore-card-cta mt-3 inline-block text-xs font-bold tracking-wide text-[var(--color-amber)] opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
						Explore →
					</span>
				</a>
			))}
		</div>
	</section>

	<section class="pointer-events-auto relative mx-auto max-w-3xl px-8 py-12 md:px-16 md:py-20" data-reveal-stagger>
		<div data-reveal-child>
			<LiveVisitorMap />
		</div>
	</section>
</Layout>
