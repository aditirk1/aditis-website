---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects', ({ data }) => data.draft !== true);
const sorted = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects · aditi's universe">
	<div class="pointer-events-auto mx-auto max-w-4xl px-2">
		<div data-reveal-stagger class="mb-12">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Projects
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		</div>
		{
			sorted.length === 0 ? (
				<p class="text-[var(--page-muted)]">
					Add projects via the{' '}
					<a href="/admin/" class="text-[var(--color-amber)] underline underline-offset-2 hover:opacity-90">
						editor
					</a>{' '}
					or place Markdown in <code class="text-[var(--color-amber)]">src/content/projects/</code>.
				</p>
			) : (
				<div class="grid gap-8 sm:grid-cols-2">
					{sorted.map((post) => (
						<article
							class="group relative flex flex-col rounded-2xl border border-[color-mix(in_srgb,var(--page-fg)_10%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] p-6 backdrop-blur-md transition-all duration-300 hover:border-[var(--color-amber)] hover:shadow-[0_0_32px_color-mix(in_srgb,var(--color-amber)_15%,transparent)]"
							data-project-card
						>
							<h2
								class="text-xl font-semibold tracking-tight"
								style="font-family: var(--font-display)"
							>
								<a
									href={`/projects/${post.id}`}
									class="text-[var(--page-fg)] underline-offset-2 hover:text-[var(--color-amber)] hover:underline"
								>
									{post.data.title}
								</a>
							</h2>
							<p class="mt-1 text-xs uppercase tracking-wider text-[var(--page-muted)]">
								{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
							</p>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--page-muted)]">{post.data.summary}</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{post.data.tags.map((t) => (
									<span class="rounded-full border border-[color-mix(in_srgb,var(--color-amber)_30%,transparent)] px-2.5 py-0.5 text-xs text-[var(--page-muted)]">
										{t}
									</span>
								))}
							</div>
							<a
								href={`/projects/${post.id}`}
								class="mt-5 block w-full rounded-full border border-[var(--color-amber)] py-2 text-center text-xs font-bold text-[var(--color-amber)] transition hover:bg-[color-mix(in_srgb,var(--color-amber)_12%,transparent)]"
							>
								Open project
							</a>
						</article>
					))}
				</div>
			)
		}
	</div>
</Layout>

