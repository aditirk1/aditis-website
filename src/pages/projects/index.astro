---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects', ({ data }) => data.draft !== true);
const sorted = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Projects · aditi's universe">
	<div class="page-list-shell">
		<div data-reveal-stagger class="page-list-header">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Projects
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		</div>
		{
			sorted.length === 0 ? (
				<p class="text-[var(--page-muted)]">
					No projects yet. Add Markdown in <code class="text-[var(--color-amber)]">src/content/projects/</code>.
				</p>
			) : (
				<nav class="project-index" aria-label="Projects" data-reveal-stagger>
					<ul class="project-index__list">
						{sorted.map((post, i) => (
							<li class="project-index__item" data-reveal-child>
								<a href={`/projects/${post.id}`} class="project-index-link" data-shade={String(i % 4)}>
									<span class="project-index-link__label">{post.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</div>
</Layout>
