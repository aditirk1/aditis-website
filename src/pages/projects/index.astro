---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects', ({ data }) => data.draft !== true);
const sorted = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
	sorted.map(async (post) => {
		const { Content } = await render(post);
		return { post, Content };
	}),
);
---

<Layout title="Projects · aditi's universe">
	<div class="pointer-events-auto mx-auto max-w-4xl px-2">
		<div data-reveal-stagger class="mb-12">
			<h1
				class="text-4xl font-semibold tracking-tight md:text-5xl"
				style="font-family: var(--font-display)"
				data-reveal-child
			>
				Projects
			</h1>
			<div class="mt-2 h-0.5 w-12 rounded-full bg-[var(--color-amber)]" data-reveal-child></div>
		</div>
		{
			rendered.length === 0 ? (
				<p class="text-[var(--page-muted)]">
					Add Markdown to <code class="text-[var(--color-amber)]">src/content/projects/</code>.
				</p>
			) : (
				<div class="grid gap-8 sm:grid-cols-2">
					{rendered.map(({ post, Content }) => (
						<article
							class="group relative overflow-hidden rounded-2xl border border-[color-mix(in_srgb,var(--page-fg)_10%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_72%,transparent)] p-6 backdrop-blur-md transition-all duration-300 hover:border-[var(--color-amber)] hover:shadow-[0_0_32px_color-mix(in_srgb,var(--color-amber)_15%,transparent)]"
							data-project-card
							data-reveal-child
						>
							<h2
								class="text-xl font-semibold tracking-tight"
								style="font-family: var(--font-display)"
							>
								{post.data.title}
							</h2>
							<p class="mt-1 text-xs uppercase tracking-wider text-[var(--page-muted)]">
								{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
							</p>
							<p class="mt-3 text-sm leading-relaxed text-[var(--page-muted)]">{post.data.summary}</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{post.data.tags.map((t) => (
									<span class="rounded-full border border-[color-mix(in_srgb,var(--color-amber)_30%,transparent)] px-2.5 py-0.5 text-xs text-[var(--page-muted)]">
										{t}
									</span>
								))}
							</div>
							<button
								type="button"
								class="mt-5 w-full rounded-full border border-[var(--color-amber)] py-2 text-xs font-bold text-[var(--color-amber)] transition hover:bg-[color-mix(in_srgb,var(--color-amber)_12%,transparent)]"
								data-project-open={post.id}
							>
								Read more
							</button>
							<dialog
								class="project-dialog pointer-events-auto w-[min(100%,640px)] max-w-[calc(100%-2rem)] rounded-2xl border border-[color-mix(in_srgb,var(--page-fg)_12%,transparent)] bg-[var(--page-bg)] p-0 shadow-2xl backdrop-blur-xl"
								id={`project-dialog-${post.id}`}
							>
								<div class="sticky top-0 z-10 flex justify-end border-b border-[color-mix(in_srgb,var(--page-fg)_10%,transparent)] bg-[color-mix(in_srgb,var(--page-bg)_95%,transparent)] px-5 py-3 backdrop-blur-sm">
									<button
										type="button"
										class="rounded-full border border-[color-mix(in_srgb,var(--page-fg)_20%,transparent)] px-3 py-1 text-xs hover:border-[var(--color-amber)] hover:text-[var(--color-amber)]"
										data-project-close
									>
										Close
									</button>
								</div>
								<div class="px-6 py-6 text-[var(--page-fg)] [&_p]:leading-relaxed">
									<h2
										class="mb-2 text-2xl font-semibold"
										style="font-family: var(--font-display)"
									>
										{post.data.title}
									</h2>
									<p class="mb-6 text-sm text-[var(--page-muted)]">{post.data.date.toLocaleDateString()}</p>
									<Content />
								</div>
							</dialog>
						</article>
					))}
				</div>
			)
		}
	</div>
</Layout>

<script>
	import { gsap } from 'gsap';

	document.querySelectorAll<HTMLButtonElement>('[data-project-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-project-open');
			const dlg = document.getElementById(`project-dialog-${id}`) as HTMLDialogElement | null;
			if (!dlg) return;
			dlg.showModal();
			gsap.fromTo(
				dlg,
				{ scale: 0.94, opacity: 0 },
				{ scale: 1, opacity: 1, duration: 0.38, ease: 'power3.out' },
			);
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-project-close]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const dlg = btn.closest('dialog') as HTMLDialogElement | null;
			dlg?.close();
		});
	});

	document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach((dlg) => {
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close();
		});
	});
</script>
